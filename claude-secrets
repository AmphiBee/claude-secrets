        # ── rendu ──

        def toast(self, text):
            self.toasts.add_toast(Adw.Toast(title=text, timeout=3))

        def toast_source(self, text):
            """Toast avec la commande pour l'activer dans un terminal ouvert."""
            self.toasts.add_toast(Adw.Toast(
                title=text, timeout=8, button_label="Copier la commande",
                action_name="win.copysource"))

        def mask(self, value, key):
            return value if key in self.revealed else MASK

        def clear(self):
            child = self.box.get_first_child()
            while child:
                nxt = child.get_next_sibling()
                self.box.remove(child)
                child = nxt

        def search_later(self):
            """Laisse finir la frappe avant de reconstruire la liste."""
            if self.search_timer:
                GLib.source_remove(self.search_timer)

            def fire():
                self.search_timer = 0
                self.show_all = False
                self.render()
                return False

            self.search_timer = GLib.timeout_add(180, fire)

        def on_close(self, *_):
            """Fermer masque la fenêtre : le prochain lancement est instantané.

            Rien de sensible ne doit rester affiché pendant qu'elle est masquée,
            et l'application ne reste pas en mémoire indéfiniment.
            """
            self.parked = True
            self.revealed.clear()
            self.expanded.clear()
            self.search.set_text("")
            self.searchbar.set_search_mode(False)
            self.show_all = False
            if self.search_timer:
                GLib.source_remove(self.search_timer)
                self.search_timer = 0
            # Vider la liste : aucune valeur ne reste dans les widgets, et la
            # réouverture n'a pas à réaliser des dizaines de lignes d'un coup.
            self.clear()
            self.results = []
            self.rendered_query = ""
            self.set_visible(False)
            if self.idle_timer:
                GLib.source_remove(self.idle_timer)
            self.idle_timer = GLib.timeout_add_seconds(IDLE_QUIT, self.idle_quit)
            return True

        def idle_quit(self):
            self.get_application().quit()
            return False

        def reappear(self):
            """Réaffiche la fenêtre masquée, puis relit le trousseau en silence."""
            if self.idle_timer:
                GLib.source_remove(self.idle_timer)
                self.idle_timer = 0
            self.parked = False
            self.reveal_pending = True      # la liste réapparaît en cascade
            self.present()
            # La fenêtre s'affiche d'abord (vide), la liste suit aussitôt.
            GLib.idle_add(lambda: (self.render(), False)[1])
            self.reload(silent=True)
            GLib.timeout_add(1500, self.auto_sync_later)   # après la lecture

        def search_key(self, _ctl, keyval, _code, _state):
            """↓ descend de la recherche vers la première ligne de la liste."""
            if keyval == Gdk.KEY_Down and self.results:
                return self.box.child_focus(Gtk.DirectionType.TAB_FORWARD)
            return False

        def copy_first(self):
            """Entrée dans la recherche : copie le premier résultat."""
            if not self.search.get_text().strip():
                return
            # SearchEntry retarde lui-même « search-changed » : juste après une
            # frappe, la liste affichée est celle de la requête précédente.
            if self.search.get_text().strip().lower() != self.rendered_query:
                if self.search_timer:
                    GLib.source_remove(self.search_timer)
                    self.search_timer = 0
                self.show_all = False
                self.render()
            if not self.results:
                return
            kind, base, _user, value, _ = self.results[0]
            what = {"pair": f"{base} (mot de passe)",
                    "aws": f"{aws_profile_label(base)} (secret)"}.get(kind, base)
            self.copy(value, what)

        def reload(self, force=True, silent=False):
            """Recharge depuis le trousseau, hors interface, puis affiche.

            silent : garde la liste affichée pendant la lecture (pas de spinner)
            et ne la reconstruit que si le contenu a changé.
            """
            silent = silent and self.data is not None and not self.needs_setup
            if (not silent and self.data is None and not self.needs_setup):
                cached = read_cache()
                if cached:
                    # Liste immédiate depuis le cache du shell ; le trousseau est
                    # relu derrière et apporte ce qui n'est pas exporté (AWS…).
                    self.preloaded = self.loading = True
                    self.items = {n: (v, e) for n, v, e in cached}
                    self.regroup()
                    silent = True
            if not silent:
                self.clear()
            if self.needs_setup:
                self.title.set_subtitle("")
                self.add_btn.set_sensitive(False)
                self.show_welcome()
                return
            self.add_btn.set_sensitive(True)
            if self.data is not None and not force:
                self.render()
                return

            if not silent:
                spinner = Gtk.Spinner(spinning=True, width_request=32,
                                      height_request=32)
                page = Adw.StatusPage(title="Lecture du trousseau…", vexpand=True)
                page.set_child(spinner)
                self.box.append(page)

            import threading

            def work():
                try:
                    items = store_all()
                except Exception as e:
                    GLib.idle_add(self.toast, f"Lecture impossible : {e}")
                    items = None
                GLib.idle_add(self.data_ready, items, silent)

            threading.Thread(target=work, daemon=True).start()

        def data_ready(self, items, silent=False):
            was_loading, self.loading = self.loading, False
            if items is None:               # lecture en échec
                if self.data is None:
                    self.items = {}
                    self.regroup()
                else:
                    self.update_subtitle()  # on garde ce qu'on affiche
                    if not silent:
                        self.render()       # retire le spinner d'une lecture forcée
                return False
            fresh = {n: (v, e) for n, v, e in items}
            if silent and fresh == self.items and not was_loading:
                return False                # rien n'a changé : pas de scintillement
            if fresh != self.items or self.data is None:
                if was_loading and ({n: v for n, (v, e) in fresh.items() if e}
                                    != {n: v for n, (v, e) in self.items.items()
                                        if e}):
                    write_cache(sorted((n, v, e) for n, (v, e) in fresh.items()))
                self.items = fresh
                self.regroup()
            else:
                self.update_subtitle()      # le cache disait déjà tout
            if not self.auto_started:
                self.auto_started = True
                GLib.timeout_add(800, self.auto_sync_later)
            return False

        def update_subtitle(self):
            total = len(self.data or [])
            text = plural(total, "secret") if total else ""
            if self.loading:
                text = (text + " · " if text else "") + "lecture du trousseau…"
            self.title.set_subtitle(text)

        def regroup(self):
            self.data = grouped([(n, v, e) for n, (v, e) in self.items.items()])
            self.entries = {f"{e[0]}|{e[1]}": e for e in self.data}
            self.taxo = Taxonomy(self.data, self.domains, self.group_overrides)
            self.render()

        def commit(self, sets=(), dels=()):
            """Répercute une modification déjà écrite dans le trousseau.

            Met à jour la mémoire et le cache sans relire le trousseau : relire
            700 entrées figeait la fenêtre environ 2 s après chaque action.
            """
            for name, value, exported in sets:
                self.items[name] = (value, exported)
            for name in dels:
                self.items.pop(name, None)
            write_cache(sorted((n, v, e) for n, (v, e) in self.items.items()))
            self.regroup()

        def render(self):
            """Construit la liste à partir des données déjà en mémoire."""
            if self.data is None or self.parked:
                return
            self.clear()
            self.results = []
            entries = self.data
            total = len(entries)
            self.update_subtitle()

            q = self.search.get_text().strip().lower()
            self.rendered_query = q
            if q:
                by_group = self.group_mode == "service" and self.taxo
                entries = [e for e in entries
                           if q in e[1].lower() or q in (e[2] or "").lower()
                           or (by_group and q in self.taxo.label_of(e[1]).lower())]

            if not total:
                self.show_empty()
                return
            if not entries:
                self.box.append(Adw.StatusPage(
                    icon_name="system-search-symbolic", vexpand=True,
                    title="Aucun résultat",
                    description=f"Aucun secret ne correspond à « {q} »."))
                return

            if not q:
                services = 0
                if self.group_mode == "service" and self.taxo:
                    services = sum(1 for g in self.taxo.group(self.data)
                                   if g["kind"] in ("service", "project"))
                self.box.append(self.hero(total, services))

            if self.group_mode == "service" and self.taxo:
                self.render_services(entries, q)
                return

            self.reveal_pending = False
            hidden = 0
            if not self.show_all and len(entries) > PAGE:
                hidden = len(entries) - PAGE
                entries = entries[:PAGE]

            sections = [
                ("Clés et tokens",
                 "Disponibles dans le terminal comme variables d'environnement.",
                 lambda e: e[0] == "single" and e[4], self.make_single_row),
                ("Identifiants",
                 "Exposés en deux variables : _USER et _PASSWORD.",
                 lambda e: e[0] == "pair", self.make_pair_row),
                ("AWS",
                 "Servis à l'AWS CLI via credential_process, hors environnement.",
                 lambda e: e[0] == "aws", self.make_aws_row),
                ("Hors environnement",
                 "Conservés chiffrés, jamais injectés dans le terminal.",
                 lambda e: e[0] == "single" and not e[4], self.make_single_row),
            ]
            # Construire plusieurs centaines de lignes d'un bloc fige la
            # fenêtre : on les ajoute par lots, en rendant la main entre chaque.
            self.render_gen += 1
            gen = self.render_gen
            queue = []
            for title, desc, keep, build in sections:
                rows = [e for e in entries if keep(e)]
                if not rows:
                    continue
                grp = Adw.PreferencesGroup(title=title, description=desc)
                self.box.append(grp)
                queue.extend((grp, e, build) for e in rows)

            self.results = [e for _, e, _ in queue]

            def pump(index=0):
                if gen != self.render_gen:
                    return False          # une nouvelle recherche a pris la main
                stop = min(index + 25, len(queue))
                for grp, e, build in queue[index:stop]:
                    grp.add(build(e))
                if stop < len(queue):
                    GLib.idle_add(pump, stop)
                elif hidden:
                    self.box.append(self.more_button(hidden))
                return False

            pump()

        def render_services(self, entries, q):
            """Une ligne dépliable par service ; son contenu naît à l'ouverture,
            donc l'affichage reste instantané même avec des centaines d'entrées."""
            groups = self.taxo.group(entries)
            self.render_gen += 1            # annule un affichage par lots en cours
            self.results = [e for g in groups for e in g["members"]]
            builders = {"single": self.make_single_row, "pair": self.make_pair_row,
                        "aws": self.make_aws_row}
            open_all = bool(q) and len(entries) <= 40
            header = Adw.PreferencesGroup(
                title="Services et projets",
                description="Regroupés d'après le nom : domaine, projet, environnement.")
            other = Adw.PreferencesGroup(
                title="Autres",
                description="Un seul secret pour ce service : sites d'un côté, "
                            "clés et accès de l'autre.")
            letters = {}                    # initiale → section de l'index
            has_other = False
            shown = 1                       # 0 est le bandeau
            for g in groups:
                members = g["members"]

                def details(ms=members, label=g["label"]):
                    self.avatar_hint = label    # même pastille dans tout le groupe
                    try:
                        return [builders[e[0]](e) for e in ms]
                    finally:
                        self.avatar_hint = None

                exp = self.expander("group", g["id"], g["label"], None,
                                    g["label"], details, force_open=open_all)
                for text, copper, wanted in (
                        ("PROJET", True, g["kind"] == "project"),
                        ("MANUEL", False, g["manual"])):
                    if wanted:
                        stamp = Gtk.Label(label=text, valign=Gtk.Align.CENTER)
                        stamp.add_css_class("stamp")
                        if copper:
                            stamp.add_css_class("stamp-copper")
                        exp.add_action(stamp)
                count = Gtk.Label(label=str(len(members)), valign=Gtk.Align.CENTER)
                count.add_css_class("count")
                count.set_tooltip_text(plural(len(members), "entrée"))
                exp.add_action(count)
                self.reveal(exp, shown)
                shown += 1
                if g["kind"] in ("sites", "acces"):
                    other.add(exp)
                    has_other = True
                    continue
                letter = unicodedata.normalize("NFD", g["label"])[:1].upper()
                if letter not in letters:
                    sec = Adw.PreferencesGroup(title=letter if letter.isalpha() else "#")
                    sec.add_css_class("letter")
                    # La lettre se centre sur la colonne des monogrammes : cercle de
                    # 36 px, 14 px de marge, soit un centre à 32 px du bord.
                    head = self.find_label(sec, "heading")
                    if head:
                        head.set_halign(Gtk.Align.START)
                        head.set_size_request(64, -1)
                        head.set_xalign(0.5)
                    letters[letter] = sec
                letters[letter].add(exp)
            if letters:
                self.box.append(header)
            for sec in letters.values():
                self.box.append(sec)
            if has_other:
                self.box.append(other)
            self.reveal_pending = False

        def more_button(self, hidden):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                          halign=Gtk.Align.CENTER, margin_top=6)
            lbl = Gtk.Label(label=f"{hidden} entrée" + ("s" if hidden > 1 else "")
                                  + " non affichée" + ("s" if hidden > 1 else ""))
            lbl.add_css_class("dim-label")
            lbl.add_css_class("caption")
            box.append(lbl)
            b = Gtk.Button(label="Tout afficher")
            b.add_css_class("pill")

            def clicked(*_):
                self.show_all = True
                self.render()
            b.connect("clicked", clicked)
            box.append(b)
            hint = Gtk.Label(label="La recherche porte sur l'ensemble des secrets.")
            hint.add_css_class("dim-label")
            hint.add_css_class("caption")
            box.append(hint)
            return box

        def hero(self, total, services=0):
            """Bandeau d'ouverture : une phrase, pas un tableau de bord."""
            card = Gtk.Box(spacing=24)
            card.add_css_class("masthead")
            txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                          valign=Gtk.Align.CENTER, hexpand=True)
            eyebrow = Gtk.Label(label="TON COFFRE", xalign=0)
            eyebrow.add_css_class("eyebrow")
            sentence = (f"{plural(total, 'secret')}, rangés en "
                        f"{plural(services, 'service')}." if services
                        else f"{plural(total, 'secret')}, sous clé.")
            title = Gtk.Label(label=sentence, xalign=0, wrap=True)
            title.add_css_class("masthead-title")
            body = Gtk.Label(
                label="Claude Code les utilise sans jamais en voir la valeur.",
                xalign=0, wrap=True)
            body.add_css_class("masthead-text")
