# ─────────────────────────── stockage ───────────────────────────

def store_set(name, value, export=True, source="local"):
    """Enregistre un secret.

    export=False : conservé dans le trousseau mais JAMAIS exposé comme variable
    d'environnement (cas des identifiants AWS, servis via credential_process).
    """
    # Purge préalable : garantit qu'un nom ne peut pas exister en double, même
    # si les attributs secondaires ont changé entre deux versions.
    Secret.password_clear_sync(SCHEMA, _attrs(name), None)
    return Secret.password_store_sync(
        SCHEMA, {**_attrs(name), "export": "1" if export else "0",
                 "source": source},
        Secret.COLLECTION_DEFAULT, f"Claude Secrets — {name}", value, None)


def store_get(name):
    return Secret.password_lookup_sync(SCHEMA, _attrs(name), None)


def store_del(name):
    return Secret.password_clear_sync(SCHEMA, _attrs(name), None)


def store_meta(include_reserved=False):
    """[(name, value, exported, source)] trié par nom.

    Les noms commençant par « _ » sont réservés à l'outil (clé de session
    Bitwarden…) : ils n'apparaissent ni dans l'app ni dans la CLI.
    """
    flags = (Secret.SearchFlags.ALL | Secret.SearchFlags.UNLOCK
             | Secret.SearchFlags.LOAD_SECRETS)
    out = []
    for item in Secret.password_search_sync(SCHEMA, {"app": OWNER}, flags, None):
        a = item.get_attributes()
        name = a.get("name")
        if not name or a.get("app") != OWNER:
            continue
        if name.startswith("_") and not include_reserved:
            continue
        exported = a.get("export", "1") != "0"
        try:
            sec = item.retrieve_secret_sync(None)
            out.append((name, sec.get_text() if sec else "", exported,
                        a.get("source", "local")))
        except GLib.Error:
            pass
    return sorted(set(out))


def store_all(only_exported=False):
    """[(name, value, exported)] trié par nom."""
    return [(n, v, e) for n, v, e, _ in store_meta()
            if e or not only_exported]


def refresh_cache():
    """Cache en tmpfs (RAM) pour un démarrage de shell instantané."""
    try:
        lines = [f"export {n}={shlex.quote(v)}"
                 for n, v, _ in store_all(only_exported=True)]
        tmp = CACHE.with_suffix(".tmp")
        tmp.write_text("\n".join(lines) + ("\n" if lines else ""))
        tmp.chmod(0o600)
        tmp.replace(CACHE)
    except Exception:
        pass


def service_error():
    """Message d'erreur si le trousseau est inutilisable, sinon None."""
    if not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        return ("Aucune session D-Bus détectée.\n\n"
                "Claude Secrets a besoin d'une session graphique ouverte. "
                "En SSH, ouvre d'abord une session sur la machine.")
    try:
        Secret.Service.get_sync(Secret.ServiceFlags.NONE, None)
    except GLib.Error as e:
        return ("Aucun service de trousseau n'est disponible.\n\n"
                "Installe puis ouvre une session avec :\n"
                "  \u2022 GNOME / Zorin / Ubuntu : gnome-keyring\n"
                "  \u2022 KDE : kwalletmanager (avec le greffon Secret Service)\n\n"
                f"D\u00e9tail : {e.message}")
    return None


# ─────────────────────────── installation ───────────────────────────

def _strip_block(text, begin, end):
    """Retire un bloc délimité, s'il existe."""
    if begin in text and end in text:
        a, b = text.index(begin), text.index(end) + len(end)
        text = text[:a].rstrip("\n") + "\n" + text[b:].lstrip("\n")
    return text


LEGACY_SHELL = [
    '# Secrets (API keys, tokens) — trousseau GNOME via `claude-secrets`',
    '# Secrets (API keys, tokens) — fichier en chmod 600',
]


def _clean_shell(text):
    """Retire le bloc marqué et les anciennes variantes non marquées."""
    text = _strip_block(text, BEGIN, END)
    out, skip = [], 0
    for line in text.splitlines():
        if skip:
            skip -= 1
            if line.rstrip().endswith("\\"):
                skip += 1
            continue
        if line.strip() in LEGACY_SHELL:
            skip = 1
            continue
        if "claude-secrets" in line or "$HOME/.claude/secrets.env" in line:
            if line.rstrip().endswith("\\"):
                skip = 1
            continue
        out.append(line)
    return "\n".join(out).rstrip("\n") + "\n"


def shell_rc():
    """Fichier de config du shell de connexion."""
    sh = os.environ.get("SHELL", "")
    if "zsh" in sh and ZSHRC.exists():
        return ZSHRC
    if "bash" in sh and BASHRC.exists():
        return BASHRC
    return ZSHRC if ZSHRC.exists() else BASHRC


def detect():
    """État de l'installation, sans rien modifier."""
    rc = shell_rc()
    st = {"shell_rc": rc, "shell": False, "claude_md": False,
          "settings": False, "desktop": False, "bin": False, "icon": False}
    try:
        st["shell"] = rc.exists() and BEGIN in rc.read_text()
    except OSError:
        pass
    try:
        st["claude_md"] = CLAUDE_MD.exists() and MD_BEGIN in CLAUDE_MD.read_text()
    except OSError:
        pass
    try:
        import json as _j
        deny = _j.loads(SETTINGS.read_text()).get("permissions", {}).get("deny", [])
        st["settings"] = all(r in deny for r in DENY_RULES)
    except Exception:
        pass
    st["desktop"] = DESKTOP.exists()
    try:
        st["icon"] = ICON_PATH.exists() and ICON_PATH.read_text() == ICON_SVG
    except OSError:
        pass
    st["bin"] = (HOME / ".local/bin/claude-secrets").exists()
    st["complete"] = all(st[k] for k in
                         ("shell", "claude_md", "settings", "desktop", "icon"))
    return st


def backup(path):
    if path.exists():
        import shutil, time
        b = path.with_name(path.name + ".bak-" + time.strftime("%Y%m%d%H%M%S"))
        shutil.copy2(path, b)
        return b
    return None


def install():
    """Déploie l'intégration dans le dossier personnel. Idempotent."""
    import json, shutil
    log = []

    # 1. Binaire dans ~/.local/bin
    target = HOME / ".local/bin/claude-secrets"
    src = pathlib.Path(__file__).resolve()
    target.parent.mkdir(parents=True, exist_ok=True)
    if src != target.resolve():
        shutil.copy2(src, target)
        target.chmod(0o755)
        log.append(f"Commande installée dans {target}")

    # 2. Shell
    rc = shell_rc()
    rc.parent.mkdir(parents=True, exist_ok=True)
    old = rc.read_text() if rc.exists() else ""
    new = _clean_shell(old) + "\n" + SHELL_BLOCK + "\n"
    if new != old:
        backup(rc)
        rc.write_text(new)
        log.append(f"Chargement des secrets ajouté à {rc.name}")

    # 3. Règles pour Claude Code
    CLAUDE_MD.parent.mkdir(parents=True, exist_ok=True)
    old = CLAUDE_MD.read_text() if CLAUDE_MD.exists() else ""
    base = _strip_block(old, MD_BEGIN, MD_END)
    if base.lstrip().startswith("# Gestion des secrets"):
        base = ""  # ancienne version non marquée, écrite par ce même outil
    new = (base.rstrip("\n") + "\n\n" if base.strip() else "") + CLAUDE_MD_BLOCK + "\n"
    if new != old:
        backup(CLAUDE_MD)
        CLAUDE_MD.write_text(new)
        log.append(f"Règles de manipulation écrites dans {CLAUDE_MD}")

    # 4. Garde-fous dans settings.json
    try:
        d = json.loads(SETTINGS.read_text()) if SETTINGS.exists() else {}
    except (json.JSONDecodeError, OSError):
        d = {}
    deny = d.setdefault("permissions", {}).setdefault("deny", [])
    added = [r for r in DENY_RULES if r not in deny]
    if added:
        backup(SETTINGS)
        deny.extend(added)
        SETTINGS.parent.mkdir(parents=True, exist_ok=True)
        SETTINGS.write_text(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
        log.append(f"{len(added)} garde-fou(s) ajouté(s) à settings.json")

    # 5. Lanceur dans le menu
    DESKTOP.parent.mkdir(parents=True, exist_ok=True)
    entry = DESKTOP_ENTRY.format(exe=target)
    if not DESKTOP.exists() or DESKTOP.read_text() != entry:
        DESKTOP.write_text(entry)
        log.append("Lanceur « Claude Secrets » ajouté au menu")
        os.system("update-desktop-database "
                  f"{shlex.quote(str(DESKTOP.parent))} 2>/dev/null")

    # 6. Icône de l'application
    if not ICON_PATH.exists() or ICON_PATH.read_text() != ICON_SVG:
        ICON_PATH.parent.mkdir(parents=True, exist_ok=True)
        ICON_PATH.write_text(ICON_SVG)
        log.append("Icône de l'application installée")
        os.system("gtk-update-icon-cache -q -t -f "
                  f"{shlex.quote(str(ICON_PATH.parents[2]))} 2>/dev/null")

    # 7. Mémoriser
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps({"installed": True, "version": 1}) + "\n")

    refresh_cache()
    return log or ["Déjà configuré — rien à changer."]


# ─────────────────────────── Bitwarden ───────────────────────────
#
# Synchronisation à sens unique : Bitwarden → trousseau. Rien n'est jamais
# renvoyé vers le coffre, pour qu'une erreur locale ne puisse pas abîmer une
# source partagée.
#
# Le mot de passe maître n'est jamais conservé. Le déverrouillage renvoie une
# clé de session, elle-même stockée chiffrée dans le trousseau et réutilisée
# pour les synchronisations suivantes. `bw lock` la révoque.

BW_SESSION_KEY = "_BW_SESSION"        # réservé : masqué dans l'app et la CLI
BW_DEFAULT_FOLDER = "Claude Secrets"
BW_NAME_FIELD = "claude_secrets_name"   # champ personnalisé : force le nom
BW_EXPORT_FIELD = "claude_secrets_export"


class BwError(Exception):
    pass


class BwLocked(BwError):
    """Le coffre est verrouillé : un mot de passe maître est nécessaire."""


def bw_bin():
    import shutil
    exe = shutil.which("bw")
    if exe:
        return exe
    for c in (HOME / ".volta/bin/bw", pathlib.Path("/snap/bin/bw"),
              HOME / ".local/bin/bw"):
        if c.exists():
            return str(c)
    raise BwError(
        "Le CLI Bitwarden est introuvable. Installe-le avec :\n"
        "  npm install -g @bitwarden/cli\n"
        "ou :\n"
        "  sudo snap install bw")


def bw_run(args, session=None, password=None, timeout=120):
    """Exécute bw. Le mot de passe passe par l'environnement du seul processus."""
    import subprocess
    env = dict(os.environ)
    env.pop("BW_SESSION", None)
    env.pop("BW_PASSWORD", None)
    if session:
        env["BW_SESSION"] = session
    if password is not None:
        env["BW_PASSWORD"] = password
    p = subprocess.run([bw_bin()] + args, capture_output=True, text=True,
                       env=env, timeout=timeout)
    return p.returncode, p.stdout.strip(), p.stderr.strip()


def bw_conf(update=None):
    """Lit ou met à jour la configuration Bitwarden dans l'état local."""
    import json
    try:
        state = json.loads(STATE.read_text())
    except (OSError, json.JSONDecodeError):
        state = {}
    conf = state.setdefault("bitwarden", {})
    if update:
        conf.update(update)
        STATE.parent.mkdir(parents=True, exist_ok=True)
        STATE.write_text(json.dumps(state, indent=2) + "\n")
    return conf


def bw_state(session=None):
    """État complet renvoyé par bw : statut, serveur et compte connecté."""
    import json
    rc, out, err = bw_run(["status"], session=session)
    if rc != 0:
        raise BwError(err or "bw status a échoué")
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        raise BwError("réponse inattendue de bw status")


def bw_status(session=None):
    """'unauthenticated', 'locked' ou 'unlocked'."""
    return bw_state(session).get("status", "unauthenticated")


def bw_set_server(server):
    """Cloud officiel si vide, sinon instance auto-hébergée (Vaultwarden inclus)."""
    url = (server or "").strip().rstrip("/") or "https://vault.bitwarden.com"
    if not url.startswith(("http://", "https://")):
        url = "https://" + url
    # bw refuse de changer de serveur tant qu'un compte est connecté.
    state = bw_state()
    if state.get("status", "unauthenticated") != "unauthenticated":
        current = (state.get("serverUrl") or "").rstrip("/")
        if current == url:
            bw_conf({"server": url})
            return url
        raise BwError(
            f"Un compte est déjà connecté sur {current}.\n"
            f"Pour basculer vers {url}, déconnecte-toi d'abord :\n"
            "  claude-secrets bw-logout")

    rc, out, err = bw_run(["config", "server", url])
    if rc != 0:
        raise BwError(err or f"impossible de configurer le serveur {url}")
    bw_conf({"server": url})
    return url


def bw_login(email, password, code=None, method=None):
    """Connecte le compte. Retourne une session, ou None si elle reste à ouvrir."""
    args = ["login", email, "--raw", "--passwordenv", "BW_PASSWORD"]
    if code:
        args += ["--code", code]
    if method:
        args += ["--method", str(method)]
    rc, out, err = bw_run(args, password=password)
    if rc == 0:
        bw_conf({"email": email})
        return out

    # Les serveurs auto-hébergés (Vaultwarden) n'implémentent pas toujours les
    # routes de migration que le CLI appelle juste après l'authentification.
    # Le compte est alors bel et bien connecté malgré le code d'erreur.
    try:
        if bw_status() in ("locked", "unlocked"):
            bw_conf({"email": email})
            return None
    except BwError:
        pass

    low = (err or "").lower()
    if "two-step" in low or "two factor" in low or "totp" in low:
        raise BwError("Ce compte demande une authentification à deux "
                      "facteurs : relance avec le code à usage unique.")
    if "migrat" in low or "backfill" in low or "404" in low:
        raise BwError(
            "Le serveur a refusé une étape que ce CLI exécute à la connexion, "
            "et le compte n'a pas été connecté.\n"
            "Ton serveur est probablement plus ancien que le CLI. Aligne les "
            "versions, par exemple :\n"
            "  npm install -g @bitwarden/cli@<version_de_ton_serveur>\n"
            f"Détail : {err.splitlines()[0] if err else ''}")
    raise BwError(err.splitlines()[0] if err else "échec de la connexion")


def bw_unlock(password):
    rc, out, err = bw_run(["unlock", "--raw", "--passwordenv", "BW_PASSWORD"],
                          password=password)
    if rc != 0:
        raise BwError(err or "mot de passe maître refusé")
    return out


def bw_session(password=None):
    """Retourne une session valide, ou lève BwLocked si un mot de passe manque."""
    session = store_get(BW_SESSION_KEY)
    if session:
        try:
            if bw_status(session) == "unlocked":
                return session
        except BwError:
            pass
    status = bw_status()
    if status == "unauthenticated":
        raise BwError("Aucun compte Bitwarden connecté. Lance d'abord :\n"
                      "  claude-secrets bw-setup")
    if password is None:
        raise BwLocked("Le coffre Bitwarden est verrouillé.")
    session = bw_unlock(password)
    store_set(BW_SESSION_KEY, session, export=False)
    return session


def bw_slug(text):
    s = re.sub(r"[^A-Za-z0-9]+", "_", text or "").strip("_").upper()
    if s and s[0].isdigit():
        s = "X" + s
    return s


def bw_folder_id(session, name):
    import json
    rc, out, err = bw_run(["list", "folders"], session=session)
    if rc != 0:
        raise BwError(err or "impossible de lister les dossiers")
    for f in json.loads(out or "[]"):
        if (f.get("name") or "").strip().lower() == name.strip().lower():
            return f.get("id")
    raise BwError(f"Le dossier « {name} » n'existe pas dans ton coffre. "
                  "Crée-le dans Bitwarden et places-y les éléments à partager "
                  "avec Claude Secrets.")


def bw_items(session, folder):
    import json
    fid = bw_folder_id(session, folder)
    rc, out, err = bw_run(["list", "items", "--folderid", fid], session=session)
    if rc != 0:
        raise BwError(err or "impossible de lister les éléments")
    return json.loads(out or "[]")


def bw_map(items):
    """Traduit les éléments Bitwarden en secrets.

    Nom de l'élément → nom de variable, sauf champ « claude_secrets_name ».
    Identifiant + mot de passe → paire _USER / _PASSWORD.
    Chaque champ personnalisé masqué devient NOM_CHAMP.
    """
    out = []
    for it in items:
        fields = {(f.get("name") or "").strip(): f
                  for f in (it.get("fields") or []) if f.get("name")}
        base = bw_slug(fields.get(BW_NAME_FIELD, {}).get("value")
                       or it.get("name"))
        if not base:
            continue
        export = True
        marker = fields.get(BW_EXPORT_FIELD, {}).get("value")
        if marker and marker.strip().lower() in ("false", "0", "non", "no"):
            export = False

        login = it.get("login") or {}
        user, pwd = (login.get("username") or "").strip(), login.get("password")
        if pwd and user:
            out.append((f"{base}_USER", user, export))
            out.append((f"{base}_PASSWORD", pwd, export))
        elif pwd:
            out.append((base, pwd, export))

        for fname, f in fields.items():
            if fname in (BW_NAME_FIELD, BW_EXPORT_FIELD):
                continue
            if f.get("type") != 1 or not f.get("value"):   # 1 = champ masqué
                continue
            out.append((f"{base}_{bw_slug(fname)}", f["value"], export))

        note = (it.get("notes") or "").strip()
        if note and not pwd and not fields:
            out.append((base, note, export))
    return out


def bw_sync(password=None, prune=False, folder=None):
    """Synchronise le coffre vers le trousseau. Retourne un rapport."""
    folder = folder or bw_conf().get("folder") or BW_DEFAULT_FOLDER
    session = bw_session(password)
    bw_run(["sync"], session=session)
    mapped = bw_map(bw_items(session, folder))

    known = {n: (v, e, s) for n, v, e, s in store_meta()}
    added, updated, removed = [], [], []
    for name, value, export in mapped:
        cur = known.get(name)
        if cur is None:
            added.append(name)
        elif cur[0] != value or cur[1] != export:
            updated.append(name)
        else:
            continue
        store_set(name, value, export=export, source="bitwarden")

    if prune:
        wanted = {n for n, _, _ in mapped}
        for name, (_v, _e, source) in known.items():
            if source == "bitwarden" and name not in wanted:
                store_del(name)
                removed.append(name)

    refresh_cache()
    bw_conf({"folder": folder})
    return {"added": added, "updated": updated, "removed": removed,
            "total": len({n for n, _, _ in mapped})}


# ─────────────────────────── AWS ───────────────────────────
#
# Les identifiants AWS ne doivent PAS devenir des variables d'environnement :
# elles écraseraient globalement le profil par défaut et rendraient le
# comportement de `--profile` imprévisible. On les stocke donc hors
# environnement (export=False) et on les sert à la demande via le mécanisme
# `credential_process`, compris nativement par l'AWS CLI, les SDK et Terraform.

AWS_DIR = HOME / ".aws"
AWS_CREDS = AWS_DIR / "credentials"
AWS_CONFIG = AWS_DIR / "config"


def aws_key(profile, field):
    """Nom de stockage pour un champ de profil AWS."""
    slug = re.sub(r"[^A-Z0-9]+", "_", profile.upper()).strip("_")
    return f"AWS_{slug}_{field.upper()}"


def aws_profiles():
    """Profils lisibles dans ~/.aws/credentials."""
    import configparser
    if not AWS_CREDS.exists():
        return {}
    c = configparser.ConfigParser()
    c.read(AWS_CREDS)
    out = {}
    for s in c.sections():
        d = {k: v for k, v in c.items(s) if v}
        if "aws_access_key_id" in d and "aws_secret_access_key" in d:
            out[s] = d
    return out


def aws_import(activate=False):
    import configparser
    profiles = aws_profiles()
    if not profiles:
        sys.exit(f"Aucun profil exploitable dans {AWS_CREDS}.")

    for name, d in profiles.items():
        store_set(aws_key(name, "access_key_id"), d["aws_access_key_id"],
                  export=False)
        store_set(aws_key(name, "secret_access_key"), d["aws_secret_access_key"],
                  export=False)
        if d.get("aws_session_token"):
            store_set(aws_key(name, "session_token"), d["aws_session_token"],
                      export=False)
        print(f"  importé : profil « {name} » "
              f"({d['aws_access_key_id'][:4]}…{d['aws_access_key_id'][-4:]})")
    refresh_cache()
    print(f"\n{len(profiles)} profil(s) dans le trousseau, hors environnement.")

    if not activate:
        print("\nRien d'autre n'a été modifié. Pour que l'AWS CLI les lise "
              "depuis le trousseau :\n  claude-secrets aws-import --activate")
        return

    # 1. credential_process dans ~/.aws/config
    exe = HOME / ".local/bin/claude-secrets"
    cfg = configparser.ConfigParser()
    if AWS_CONFIG.exists():
        cfg.read(AWS_CONFIG)
    backup(AWS_CONFIG)
    for name in profiles:
        section = "default" if name == "default" else f"profile {name}"
        if not cfg.has_section(section):
            cfg.add_section(section)
        cfg.set(section, "credential_process", f"{exe} aws-credentials {name}")
    with open(AWS_CONFIG, "w") as fh:
        cfg.write(fh)
    AWS_CONFIG.chmod(0o600)
    print(f"\n  credential_process écrit dans {AWS_CONFIG}")

    # 2. Le fichier credentials est prioritaire : il doit être écarté.
    disabled = AWS_CREDS.with_suffix(".disabled")
    backup(AWS_CREDS)
    AWS_CREDS.rename(disabled)
    disabled.chmod(0o600)
    print(f"  {AWS_CREDS.name} renommé en {disabled.name} "
          "(il avait priorité sur credential_process)")
    print("\nVérifie avec :  aws sts get-caller-identity --profile "
          + next(iter(profiles)))


def aws_credentials(profile):
    """Sortie JSON attendue par credential_process."""
    import json as _json
    akid = store_get(aws_key(profile, "access_key_id"))
    secret = store_get(aws_key(profile, "secret_access_key"))
    if not akid or not secret:
        sys.exit(f"Profil « {profile} » absent du trousseau. "
                 "Lance : claude-secrets aws-import")
    out = {"Version": 1, "AccessKeyId": akid, "SecretAccessKey": secret}
    token = store_get(aws_key(profile, "session_token"))
    if token:
        out["SessionToken"] = token
    print(_json.dumps(out))


