def cli(argv):
    cmd = argv[0] if argv else "help"

    if cmd == "list":
        entries = grouped(store_all())
        if not entries:
            print("(aucun secret)")
            return
        for kind, base, user, _, exported in entries:
            tag = "" if exported else "   [non exporté]"
            if kind == "pair":
                print(f"{base:<32} identifiant + mot de passe  ({user}){tag}")
            elif kind == "aws":
                print(f"{base:<32} profil AWS « {aws_profile_label(base)} »{tag}")
            else:
                print(f"{base}{tag}")

    elif cmd == "get":
        if len(argv) < 2:
            sys.exit("usage: claude-secrets get NOM")
        v = store_get(argv[1])
        if v is None:
            sys.exit(f"'{argv[1]}' introuvable")
        print(v)

    elif cmd == "set":
        if len(argv) < 2:
            sys.exit("usage: claude-secrets set NOM [VALEUR]")
        name = argv[1]
        if not NAME_RE.match(name):
            sys.exit("Nom invalide : majuscules, chiffres et _ uniquement.")
        if len(argv) >= 3:
            value = argv[2]
        else:
            import getpass
            value = getpass.getpass(f"Valeur pour {name} (masquée) : ")
        if not value:
            sys.exit("Valeur vide, abandon.")
        store_set(name, value)
        refresh_cache()
        print(f"{name} enregistré ({len(value)} caractères).")

    elif cmd == "set-login":
        if len(argv) < 2:
            sys.exit("usage: claude-secrets set-login NOM [IDENTIFIANT]")
        name = argv[1].upper()
        if not NAME_RE.match(name):
            sys.exit("Nom invalide : majuscules, chiffres et _ uniquement.")
        if name.endswith(("_USER", "_PASSWORD")):
            sys.exit("Donne le nom de base, sans _USER ni _PASSWORD.")
        user = argv[2] if len(argv) >= 3 else input(f"Identifiant pour {name} : ").strip()
        if not user:
            sys.exit("Identifiant vide, abandon.")
        import getpass
        pw = getpass.getpass(f"Mot de passe pour {name} (masqué) : ")
        if not pw:
            sys.exit("Mot de passe vide, abandon.")
        save_pair(name, user, pw)
        refresh_cache()
        print(f"{name} enregistré → ${name}_USER et ${name}_PASSWORD")

    elif cmd in ("version", "--version", "-V"):
        print(f"Claude Secrets {VERSION}")

    elif cmd == "bw-setup":
        import getpass
        print("Configuration de la synchronisation Bitwarden.\n")
        try:
            bw_bin()
        except BwError as e:
            sys.exit(str(e))
        state = bw_state()
        if state.get("status", "unauthenticated") == "unauthenticated":
            server = input("URL du serveur (vide = bitwarden.com) : ").strip()
            url = bw_set_server(server)
            print(f"  serveur : {url}")
            email = input("Adresse e-mail Bitwarden : ").strip()
            pwd = getpass.getpass("Mot de passe maître (masqué) : ")
            code = input("Code à deux facteurs (vide si aucun) : ").strip()
            session = bw_login(email, pwd, code or None)
            if session is None:
                print("  compte connecté (le serveur a refusé une étape de "
                      "migration, sans conséquence ici)")
                session = bw_unlock(pwd)
        else:
            url = (state.get("serverUrl") or "").rstrip("/")
            email = state.get("userEmail") or ""
            print(f"Déjà connecté : {email} sur {url}")
            print("Pour changer de compte ou de serveur : claude-secrets bw-logout\n")
            bw_conf({"server": url, "email": email})
            pwd = getpass.getpass("Mot de passe maître (masqué) : ")
            session = bw_unlock(pwd)
        store_set(BW_SESSION_KEY, session, export=False)
        folder = input(f"Dossier à synchroniser [{BW_DEFAULT_FOLDER}] : ").strip()
        bw_conf({"folder": folder or BW_DEFAULT_FOLDER})
        print("\nConnecté. Le mot de passe maître n'a pas été conservé ; "
              "seule la clé de session l'a été, chiffrée dans le trousseau.")
        print("Synchronise avec :  claude-secrets bw-sync")

    elif cmd == "bw-sync":
        import getpass
        try:
            try:
                rep_ = bw_sync(prune="--prune" in argv)
            except BwLocked:
                pwd = getpass.getpass("Mot de passe maître Bitwarden (masqué) : ")
                rep_ = bw_sync(password=pwd, prune="--prune" in argv)
        except BwError as e:
            sys.exit(f"Erreur : {e}")
        for label, names in (("ajouté", rep_["added"]), ("mis à jour", rep_["updated"]),
                             ("supprimé", rep_["removed"])):
            for n in names:
                print(f"  {label} : {n}")
        print(f"\n{rep_['total']} secret(s) dans le dossier Bitwarden.")
        if not (rep_["added"] or rep_["updated"] or rep_["removed"]):
            print("Rien à changer.")

    elif cmd == "bw-logout":
        store_del(BW_SESSION_KEY)
        rc, out, err = bw_run(["logout"])
        bw_conf({"email": None})
        print("Compte Bitwarden déconnecté." if rc == 0
              else f"bw logout : {err or out}")

    elif cmd == "bw-lock":
        store_del(BW_SESSION_KEY)
        try:
            bw_run(["lock"])
        except BwError:
            pass
        print("Session Bitwarden oubliée.")

    elif cmd == "aws-import":
        aws_import(activate="--activate" in argv)

    elif cmd == "aws-credentials":
        if len(argv) < 2:
            sys.exit("usage: claude-secrets aws-credentials PROFIL")
        aws_credentials(argv[1])

    elif cmd == "install":
        for line in install():
            print("  •", line)
        print("\nOuvre un nouveau terminal pour que les secrets soient chargés.")

    elif cmd == "doctor":
        print(f"  Claude Secrets {VERSION}\n")
        st = detect()
        label = {"bin": "Commande claude-secrets", "shell": f"Chargement dans {st['shell_rc'].name}",
                 "claude_md": "Règles dans ~/.claude/CLAUDE.md",
                 "settings": "Garde-fous dans settings.json",
                 "desktop": "Lanceur « Claude Secrets » dans le menu",
                 "icon": "Icône de l'application"}
        for k, lbl in label.items():
            print(f"  [{'✓' if st[k] else ' '}] {lbl}")
        conf = bw_conf()
        if conf.get("email"):
            try:
                state = {"unlocked": "déverrouillé", "locked": "verrouillé",
                         "unauthenticated": "déconnecté"}[bw_status(
                             store_get(BW_SESSION_KEY))]
            except Exception:
                state = "indisponible"
            print(f"\n  Bitwarden : {conf['email']} · dossier "
                  f"« {conf.get('folder', BW_DEFAULT_FOLDER)} » · {state}")

        print()
        print("Installation complète." if st["complete"]
              else "Incomplet — lance : claude-secrets install")

        # Une copie du dépôt à côté est-elle différente de celle installée ?
        src = pathlib.Path(__file__).resolve()
        inst = (HOME / ".local/bin/claude-secrets").resolve()
        if src != inst and inst.exists():
            import hashlib
            h = lambda f: hashlib.sha256(f.read_bytes()).hexdigest()
            if h(src) != h(inst):
                print("\nLa version installée diffère de celle de ce dépôt.")
                print("Mets à jour avec :  ./install.sh")

    elif cmd == "rm":
        if len(argv) < 2:
            sys.exit("usage: claude-secrets rm NOM")
        name = argv[1]
        hit = store_del(name)
        if not hit and store_get(name + "_PASSWORD") is not None:
            delete_entry("pair", name)
            hit = True
            print(f"{name} supprimé (identifiant + mot de passe).")
        elif hit:
            print(f"{name} supprimé.")
        else:
            print(f"'{name}' introuvable")
        refresh_cache()

    elif cmd == "export":
        for n, v, _ in store_all(only_exported=True):
            print(f"export {n}={shlex.quote(v)}")
        refresh_cache()

    elif cmd == "import":
        src = pathlib.Path(argv[1]) if len(argv) > 1 else LEGACY
        if not src.exists():
            sys.exit(f"{src} introuvable")
        n = 0
        for name, raw in parse_env(src.read_text()):
            store_set(name, raw)
            n += 1
            print(f"  importé : {name}")
        refresh_cache()
        print(f"{n} secret(s) importé(s) depuis {src}.")

    else:
        print(__doc__.strip())


# ─────────────────────────── regroupement ───────────────────────────

AWS_ID_SUFFIX = "_ACCESS_KEY_ID"
AWS_SECRET_SUFFIX = "_SECRET_ACCESS_KEY"


def aws_profile_label(base):
    """AWS_AMPHIBEE → amphibee"""
    return base[4:].lower() if base.startswith("AWS_") else base.lower()


def grouped(items):
    """Regroupe les secrets en entrées logiques.

    Retourne [(kind, base, user, value, exported)] où kind vaut :
      "pair"   NOM_USER + NOM_PASSWORD
      "aws"    AWS_<PROFIL>_ACCESS_KEY_ID + _SECRET_ACCESS_KEY, hors environnement
      "single" tout le reste
    """
    d = {n: v for n, v, _ in items}
    exp = {n: e for n, _, e in items}
    out, used = [], set()
    for n in sorted(d):
        if n.endswith("_USER") and (n[:-5] + "_PASSWORD") in d:
            base = n[:-5]
            out.append(("pair", base, d[n], d[base + "_PASSWORD"], exp[n]))
            used.update({n, base + "_PASSWORD"})
        elif (n.startswith("AWS_") and n.endswith(AWS_ID_SUFFIX) and not exp[n]
              and (n[:-len(AWS_ID_SUFFIX)] + AWS_SECRET_SUFFIX) in d):
            base = n[:-len(AWS_ID_SUFFIX)]
            out.append(("aws", base, d[n], d[base + AWS_SECRET_SUFFIX], False))
            used.update({n, base + AWS_SECRET_SUFFIX, base + "_SESSION_TOKEN"})
    for n in sorted(d):
        if n not in used:
            out.append(("single", n, None, d[n], exp[n]))
    return sorted(out, key=lambda r: r[1])


# ─────────────────────────── classement par service ───────────────────────────
#
# Les noms viennent surtout des sites de Bitwarden : APP_HUBSPOT_COM est
# app.hubspot.com, PREPROD_ECRANLARGE_AMPHIBEE_FR est preprod.ecranlarge… On
# retire ce qui n'identifie pas le service (extension, environnement,
# sous-domaine générique, mot de variable), puis on retient le premier mot qui
# se retrouve dans au moins deux entrées. Rien n'est stocké : tout se déduit
# des noms, donc une nouvelle entrée est classée sans réglage.

TLDS = frozenset("COM FR NET ORG IO AI DEV CH ME TO EU BE CO APP INFO XYZ TV "
                 "SH DE ES NL CA US UK LY BEER".split())
ENV_RE = re.compile(r"^(PROD|PRODUCTION|NEWPROD|PRE?PROD\w*|STAGING|STAGE|DEV|"
                    r"DDEV|LOCAL|LOCALHOST|DOCKER|TEST|RECETTE|DEMO|BETA)$")
# préfixes qui décrivent la page, pas le service : app.x.com, login.x.com…
GENERIC = frozenset("APP LOGIN ID ADMIN WP WWW DASHBOARD DASH API CLOUD CONSOLE "
                    "PANEL ACCOUNT ACCOUNTS MY PORTAL SSO AUTH MANAGER MAIL "
                    "SECURE GIT ONE OUTILS PROJETS PMA CONNECT".split())
# mots de variable : ils ne peuvent jamais désigner un service
WORDS = frozenset("API KEY TOKEN SECRET CLIENT ID USER USERNAME PASSWORD URL DB "
                  "ACCESS ADMIN ROOT SUDO PERSONAL BOT WEBHOOK HTTP SSH FTP SMTP "
                  "MAIL RECIPIENTS ENROLLMENT SECURITY UPDATES TRIGGER INSTANCE "
                  "ADMINISTRATION MASTER DEFAULT".split())


def _learn_generic(split):
    """Préfixes génériques non listés : un premier mot suivi de nombreux sites
    différents (sso.a.com, sso.b.com, sso.c.com…) décrit une page, pas un service."""
    import collections
    followers, count = collections.defaultdict(set), collections.Counter()
    for t in split:
        if len(t) >= 3 and t[-1] in TLDS:
            rest = [x for x in t[:-1] if not ENV_RE.match(x)]
            if len(rest) >= 2 and rest[0] not in GENERIC | WORDS:
                followers[rest[0]].add(rest[1])
                count[rest[0]] += 1
    return {k for k, v in followers.items() if len(v) >= 4 and count[k] >= 4}


def _significant(tokens, generic):
    t = list(tokens)
    if len(t) > 1 and t[-1] in TLDS:
        t.pop()
    t = [x for x in t if not ENV_RE.match(x)] or t
    while len(t) > 1 and t[0] in generic:
        t.pop(0)
    return t


# suffixes publics à deux niveaux : foo.co.uk, impots.gouv.fr
_SECOND_LEVEL = frozenset("co com org net gov gouv asso ac edu".split())


def registrable(host):
    """hubspot.com pour app.hubspot.com ; impots.gouv.fr reste entier."""
    labels = host.split(".")
    if len(labels) < 2:
        return None
    if len(labels) >= 3 and labels[-2] in _SECOND_LEVEL and len(labels[-1]) == 2:
        return ".".join(labels[-3:])
    return ".".join(labels[-2:])


def _norm(label):
    return label.upper().replace("-", "").replace("_", "")


class Taxonomy:
    """Classe les entrées par service.

    `domains` ({nom: hôte}, issu de l'adresse web des éléments Bitwarden) prime
    sur le nom quand on le connaît : il désigne le service sans ambiguïté.
    """

    def __init__(self, entries, domains=None, overrides=None):
        import collections
        domains = domains or {}
        overrides = overrides or {}
        split = {e[1]: e[1].split("_") for e in entries}
        generic = GENERIC | _learn_generic(split.values())
        sig = {b: _significant(t, generic) for b, t in split.items()}
        usable = lambda tok: len(tok) > 1 and tok not in WORDS
        freq = collections.Counter(tok for s in sig.values()
                                   for tok in set(s) if usable(tok))

        # 1. service d'après l'adresse web
        self.display = {}
        site = {}                       # base → (domaine, sous-domaines)
        for e in entries:
            host = domains.get(e[1])
            reg = registrable(host) if host else None
            if reg:
                subs = host[:-len(reg) - 1].split(".") if host != reg else []
                site[e[1]] = (reg, subs)
        # Un sous-domaine est un projet hébergé (preprod.ecranlarge.amphibee.fr)
        # seulement s'il existe aussi ailleurs dans le coffre : docs.google.com
        # ne doit pas éclater « Google » en « Docs », « Drive »…
        elsewhere = collections.defaultdict(set)
        for e in entries:
            reg = site.get(e[1], (None,))[0]
            toks = {t for t in sig[e[1]] if usable(t)}
            if reg:
                toks.add(_norm(reg.split(".")[0]))
            for t in toks:
                elsewhere[t].add(reg)
        domain_key = {}
        for base, (reg, subs) in site.items():
            tenants = [x for x in subs
                       if not ENV_RE.match(x.upper().replace("-", "_"))
                       and x.upper().replace("-", "_") not in generic]
            tenant = tenants[-1] if tenants else None
            if tenant and elsewhere[_norm(tenant)] - {reg}:
                raw = tenant
            else:
                raw = reg.split(".")[0]
            domain_key[base] = _norm(raw)
            self.display.setdefault(_norm(raw), raw.replace("-", " ").title())
        known_domains = set(domain_key.values())

        # 2. à défaut, d'après le nom
        self.key, self.domain, self.projects = {}, {}, set()
        for e in entries:
            kind, base = e[0], e[1]
            tokens = split[base]
            if kind == "aws":
                self.key[base] = "AWS"
            elif base in domain_key:
                self.key[base] = domain_key[base]
            else:
                self.key[base] = next(
                    (tok for tok in sig[base] if usable(tok)
                     and (freq[tok] >= 2 or tok in known_domains)), None)
            self.domain[base] = base in site or (
                len(tokens) > 1 and tokens[-1] in TLDS)
        # 3. le choix de l'utilisateur prime sur tout le reste, y compris pour
        # un groupe d'une seule entrée (il l'a voulu ainsi)
        self.overridden, forced = set(), set()
        for e in entries:
            label = (overrides.get(e[1]) or "").strip()
            if label and _norm(label):
                key = _norm(label)
                self.key[e[1]] = key
                self.display.setdefault(key, label)
                self.overridden.add(e[1])
                forced.add(key)

        # Un mot partagé par deux noms dont l'un a été classé sous un autre mot
        # laisse un groupe d'un seul membre : ce n'est pas un service.
        size = collections.Counter(k for k in self.key.values() if k)
        for base, key in self.key.items():
            if key and key != "AWS" and key not in forced and size[key] < 2:
                self.key[base] = None
        for base, key in self.key.items():
            tokens = split[base]
            body = tokens[:-1] if len(tokens) > 1 and tokens[-1] in TLDS else tokens
            subs = site.get(base, (None, []))[1]
            # un environnement dans le nom ou dans l'adresse : c'est un projet
            if key and key != "AWS" and (
                    any(ENV_RE.match(x) for x in body)
                    or any(ENV_RE.match(x.upper().replace("-", "_")) for x in subs)):
                self.projects.add(key)

    def label_of(self, base):
        """Nom du groupe d'une entrée, ou "" si elle n'est dans aucun service."""
        key = self.key.get(base)
        return self.display.get(key, key.title()) if key else ""

    def group(self, entries):
        """[{id, label, kind, manual, members}] : services d'abord, puis isolés.

        kind : "service", "project", ou "sites" / "acces" pour les entrées sans
        service commun avec une autre (avec ou sans nom de domaine).
        """
        by_key, sites, acces = {}, [], []
        for e in sorted(entries, key=lambda e: e[1]):
            key = self.key.get(e[1])
            if key:
                by_key.setdefault(key, []).append(e)
            else:
                (sites if self.domain.get(e[1]) else acces).append(e)
        out = [{"id": f"svc:{k}", "label": self.display.get(k, k.title()),
                "members": m,
                "manual": all(e[1] in self.overridden for e in m),
                "kind": "project" if k in self.projects else "service"}
               for k, m in sorted(by_key.items())]
        if sites:
            out.append({"id": "bucket:sites", "label": "Autres sites",
                        "kind": "sites", "manual": False, "members": sites})
        if acces:
            out.append({"id": "bucket:acces", "label": "Autres clés et accès",
                        "kind": "acces", "manual": False, "members": acces})
        return out


def save_pair(base, user, password):
    store_set(base + "_USER", user)
    store_set(base + "_PASSWORD", password)


def entry_names(kind, base):
    """Noms de trousseau qui composent une entrée."""
    if kind == "pair":
        return [base + "_USER", base + "_PASSWORD"]
    if kind == "aws":
        return [base + s for s in (AWS_ID_SUFFIX, AWS_SECRET_SUFFIX,
                                   "_SESSION_TOKEN")]
    return [base]


def delete_entry(kind, base):
    if kind == "pair":
        store_del(base + "_USER")
        store_del(base + "_PASSWORD")
    elif kind == "aws":
        for suffix in (AWS_ID_SUFFIX, AWS_SECRET_SUFFIX, "_SESSION_TOKEN"):
            store_del(base + suffix)
    else:
        store_del(base)


