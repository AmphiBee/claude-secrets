            if kind == "aws":
                return
            self.edit_dialog(kind, base, user, value, exported)

        def edit_dialog(self, kind=None, base=None, user=None, value="",
                        exported=True):
            editing = base is not None
            dlg = Adw.MessageDialog(
                transient_for=self, modal=True,
                heading=f"Modifier {base}" if editing else "Nouveau secret")

            grp = Adw.PreferencesGroup(margin_top=12)
            combo = Adw.ComboRow(
                title="Type",
                model=Gtk.StringList.new(["Clé ou token",
                                          "Identifiant + mot de passe"]))
            combo.set_selected(1 if kind == "pair" else 0)
            combo.set_visible(not editing)
            grp.add(combo)

            name_row = Adw.EntryRow(title="Nom de la variable")
            name_row.set_text(base or "")
            name_row.set_visible(not editing)
            grp.add(name_row)

            user_row = Adw.EntryRow(title="Identifiant")
            user_row.set_text(user or "")
            grp.add(user_row)

            val_row = Adw.PasswordEntryRow(title="Mot de passe")
            val_row.set_text(value)
            grp.add(val_row)

            hint = Gtk.Label(wrap=True, margin_top=12, xalign=0)
            hint.add_css_class("dim-label")
            hint.add_css_class("caption")

            def normalized():
                return (name_row.get_text().strip().upper()
                        .replace("-", "_").replace(" ", "_"))

            def sync(*_):
                pair = combo.get_selected() == 1
                user_row.set_visible(pair)
                val_row.set_title("Mot de passe" if pair else "Valeur")
                n = normalized() or "NOM"
                if not exported:
                    hint.set_text("Secret hors environnement : il reste invisible "
                                  "dans le terminal.")
                else:
                    hint.set_text(f"Variables créées : ${n}_USER et ${n}_PASSWORD"
                                  if pair else f"Variable créée : ${n}")
            combo.connect("notify::selected", sync)
            name_row.connect("changed", sync)
            sync()

            wrap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            wrap.append(grp)
            wrap.append(hint)
            dlg.set_extra_child(wrap)

            dlg.add_response("cancel", "Annuler")
            dlg.add_response("save", "Enregistrer")
            dlg.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)
            dlg.set_default_response("save")
            dlg.set_close_response("cancel")

            def done(d, resp):
                if resp != "save":
                    return
                pair = combo.get_selected() == 1
                n = base if editing else normalized()
                v = val_row.get_text()
                if not NAME_RE.match(n):
                    self.toast("Nom invalide : majuscules, chiffres et _")
                    return
                if pair and n.endswith(("_USER", "_PASSWORD")):
                    self.toast("Donne le nom de base, sans _USER ni _PASSWORD")
                    return
                if not v:
                    self.toast("Valeur vide, rien n'a été enregistré")
                    return
                if pair:
                    u = user_row.get_text().strip()
                    if not u:
                        self.toast("Identifiant vide")
                        return
                    save_pair(n, u, v)
                else:
                    # Conserver le statut d'export : modifier un secret hors
                    # environnement ne doit pas le faire entrer dans le terminal.
                    store_set(n, v, export=exported)
                refresh_cache()
                self.reload()
                self.toast(f"{n} enregistré")
            dlg.connect("response", done)
            dlg.present()

        def confirm_delete(self, target):
            e = self.entries.get(target)
            if not e:
                return
            kind, base = e[0], e[1]
            label = f"le profil AWS « {aws_profile_label(base)} »" if kind == "aws" else base
            body = {
                "pair": "L'identifiant et le mot de passe seront supprimés.",
                "aws": "Les clés seront retirées du trousseau. Pense à retirer "
                       "aussi la ligne credential_process de ~/.aws/config.",
            }.get(kind, "Cette action est définitive.")
            dlg = Adw.MessageDialog(transient_for=self, modal=True,
                                    heading=f"Supprimer {label} ?", body=body)
            dlg.add_response("cancel", "Annuler")
            dlg.add_response("del", "Supprimer")
            dlg.set_response_appearance("del", Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_close_response("cancel")

            def done(d, resp):
                if resp == "del":
                    delete_entry(kind, base)
                    self.expanded.discard(base)
                    refresh_cache()
                    self.reload()
                    self.toast("Supprimé")
            dlg.connect("response", done)
            dlg.present()

