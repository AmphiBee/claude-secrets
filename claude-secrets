if __name__ == "__main__":
    args = sys.argv[1:]
    # `install`, `doctor` et l'aide ne touchent pas au trousseau : ils doivent
    # fonctionner même sur une machine pas encore configurée.
    if args and args[0] in ("install", "doctor", "help", "--help", "-h"):
        cli(args)
    else:
        err = service_error()
        if err:
            if args:
                sys.exit("Erreur : " + err)
            gui_error(err)
        elif args:
            cli(args)
        else:
            gui()
