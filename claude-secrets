def cli(argv):
    cmd = argv[0] if argv else "help"

    if cmd == "list":
        entries = grouped(store_all())
        if not entries:
            print("(aucun secret)")
            return
        for kind, base, user, _, exported in entries:
            tag = "" if exported else "   [non exporté]"
            if kind == "pair":
                print(f"{base:<32} identifiant + mot de passe  ({user}){tag}")
            elif kind == "aws":
                print(f"{base:<32} profil AWS « {aws_profile_label(base)} »{tag}")
            else:
                print(f"{base}{tag}")

    elif cmd == "get":
        if len(argv) < 2:
            sys.exit("usage: claude-secrets get NOM")
        v = store_get(argv[1])
        if v is None:
            sys.exit(f"'{argv[1]}' introuvable")
        print(v)

    elif cmd == "set":
        if len(argv) < 2:
            sys.exit("usage: claude-secrets set NOM [VALEUR]")
        name = argv[1]
        if not NAME_RE.match(name):
            sys.exit("Nom invalide : majuscules, chiffres et _ uniquement.")
        if len(argv) >= 3:
            value = argv[2]
        else:
            import getpass
            value = getpass.getpass(f"Valeur pour {name} (masquée) : ")
        if not value:
            sys.exit("Valeur vide, abandon.")
        store_set(name, value)
        refresh_cache()
        print(f"{name} enregistré ({len(value)} caractères).")

    elif cmd == "set-login":
        if len(argv) < 2:
            sys.exit("usage: claude-secrets set-login NOM [IDENTIFIANT]")
        name = argv[1].upper()
        if not NAME_RE.match(name):
            sys.exit("Nom invalide : majuscules, chiffres et _ uniquement.")
        if name.endswith(("_USER", "_PASSWORD")):
            sys.exit("Donne le nom de base, sans _USER ni _PASSWORD.")
        user = argv[2] if len(argv) >= 3 else input(f"Identifiant pour {name} : ").strip()
        if not user:
            sys.exit("Identifiant vide, abandon.")
        import getpass
        pw = getpass.getpass(f"Mot de passe pour {name} (masqué) : ")
        if not pw:
            sys.exit("Mot de passe vide, abandon.")
        save_pair(name, user, pw)
        refresh_cache()
        print(f"{name} enregistré → ${name}_USER et ${name}_PASSWORD")

    elif cmd in ("version", "--version", "-V"):
        print(f"Claude Secrets {VERSION}")

    elif cmd == "bw-setup":
        import getpass
        print("Configuration de la synchronisation Bitwarden.\n")
        try:
            bw_bin()
        except BwError as e:
            sys.exit(str(e))
        state = bw_state()
        if state.get("status", "unauthenticated") == "unauthenticated":
            server = input("URL du serveur (vide = bitwarden.com) : ").strip()
            url = bw_set_server(server)
            print(f"  serveur : {url}")
            email = input("Adresse e-mail Bitwarden : ").strip()
            pwd = getpass.getpass("Mot de passe maître (masqué) : ")
            code = input("Code à deux facteurs (vide si aucun) : ").strip()
            session = bw_login(email, pwd, code or None)
            if session is None:
                print("  compte connecté (le serveur a refusé une étape de "
                      "migration, sans conséquence ici)")
                session = bw_unlock(pwd)
        else:
            url = (state.get("serverUrl") or "").rstrip("/")
            email = state.get("userEmail") or ""
            print(f"Déjà connecté : {email} sur {url}")
            print("Pour changer de compte ou de serveur : claude-secrets bw-logout\n")
            bw_conf({"server": url, "email": email})
            pwd = getpass.getpass("Mot de passe maître (masqué) : ")
            session = bw_unlock(pwd)
        store_set(BW_SESSION_KEY, session, export=False)
        folder = input(f"Dossier à synchroniser [{BW_DEFAULT_FOLDER}] : ").strip()
        bw_conf({"folder": folder or BW_DEFAULT_FOLDER})
        print("\nConnecté. Le mot de passe maître n'a pas été conservé ; "
              "seule la clé de session l'a été, chiffrée dans le trousseau.")
        print("Synchronise avec :  claude-secrets bw-sync")

    elif cmd == "bw-sync":
        import getpass
        try:
            try:
                rep_ = bw_sync(prune="--prune" in argv)
            except BwLocked:
                pwd = getpass.getpass("Mot de passe maître Bitwarden (masqué) : ")
                rep_ = bw_sync(password=pwd, prune="--prune" in argv)
        except BwError as e:
            sys.exit(f"Erreur : {e}")
        for label, names in (("ajouté", rep_["added"]), ("mis à jour", rep_["updated"]),
                             ("supprimé", rep_["removed"])):
            for n in names:
                print(f"  {label} : {n}")
        print(f"\n{rep_['total']} secret(s) dans le dossier Bitwarden.")
        if not (rep_["added"] or rep_["updated"] or rep_["removed"]):
            print("Rien à changer.")

    elif cmd == "bw-logout":
        store_del(BW_SESSION_KEY)
        rc, out, err = bw_run(["logout"])
        bw_conf({"email": None})
        print("Compte Bitwarden déconnecté." if rc == 0
              else f"bw logout : {err or out}")

    elif cmd == "bw-lock":
        store_del(BW_SESSION_KEY)
        try:
            bw_run(["lock"])
        except BwError:
            pass
        print("Session Bitwarden oubliée.")

    elif cmd == "aws-import":
        aws_import(activate="--activate" in argv)

    elif cmd == "aws-credentials":
        if len(argv) < 2:
            sys.exit("usage: claude-secrets aws-credentials PROFIL")
        aws_credentials(argv[1])

    elif cmd == "install":
        for line in install():
            print("  •", line)
        print("\nOuvre un nouveau terminal pour que les secrets soient chargés.")

    elif cmd == "doctor":
        print(f"  Claude Secrets {VERSION}\n")
        st = detect()
        label = {"bin": "Commande claude-secrets", "shell": f"Chargement dans {st['shell_rc'].name}",
                 "claude_md": "Règles dans ~/.claude/CLAUDE.md",
                 "settings": "Garde-fous dans settings.json",
                 "desktop": "Lanceur « Claude Secrets » dans le menu",
                 "icon": "Icône de l'application"}
        for k, lbl in label.items():
            print(f"  [{'✓' if st[k] else ' '}] {lbl}")
        conf = bw_conf()
        if conf.get("email"):
            try:
                state = {"unlocked": "déverrouillé", "locked": "verrouillé",
                         "unauthenticated": "déconnecté"}[bw_status(
                             store_get(BW_SESSION_KEY))]
            except Exception:
                state = "indisponible"
            print(f"\n  Bitwarden : {conf['email']} · dossier "
                  f"« {conf.get('folder', BW_DEFAULT_FOLDER)} » · {state}")

        print()
        print("Installation complète." if st["complete"]
              else "Incomplet — lance : claude-secrets install")

        # Une copie du dépôt à côté est-elle différente de celle installée ?
        src = pathlib.Path(__file__).resolve()
        inst = (HOME / ".local/bin/claude-secrets").resolve()
        if src != inst and inst.exists():
            import hashlib
            h = lambda f: hashlib.sha256(f.read_bytes()).hexdigest()
            if h(src) != h(inst):
                print("\nLa version installée diffère de celle de ce dépôt.")
                print("Mets à jour avec :  ./install.sh")

    elif cmd == "rm":
        if len(argv) < 2:
            sys.exit("usage: claude-secrets rm NOM")
        name = argv[1]
        hit = store_del(name)
        if not hit and store_get(name + "_PASSWORD") is not None:
            delete_entry("pair", name)
            hit = True
            print(f"{name} supprimé (identifiant + mot de passe).")
        elif hit:
            print(f"{name} supprimé.")
        else:
            print(f"'{name}' introuvable")
        refresh_cache()

    elif cmd == "export":
        for n, v, _ in store_all(only_exported=True):
            print(f"export {n}={shlex.quote(v)}")
        refresh_cache()

    elif cmd == "import":
        src = pathlib.Path(argv[1]) if len(argv) > 1 else LEGACY
        if not src.exists():
            sys.exit(f"{src} introuvable")
        n = 0
        for line in src.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            m = re.match(r'^(?:export\s+)?([A-Z][A-Z0-9_]*)=(.*)$', line)
            if not m:
                continue
            name, raw = m.group(1), m.group(2).strip()
            if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'":
                raw = raw[1:-1]
            if raw:
                store_set(name, raw)
                n += 1
                print(f"  importé : {name}")
        refresh_cache()
        print(f"{n} secret(s) importé(s) depuis {src}.")

    else:
        print(__doc__.strip())


# ─────────────────────────── regroupement ───────────────────────────

AWS_ID_SUFFIX = "_ACCESS_KEY_ID"
AWS_SECRET_SUFFIX = "_SECRET_ACCESS_KEY"


def aws_profile_label(base):
    """AWS_AMPHIBEE → amphibee"""
    return base[4:].lower() if base.startswith("AWS_") else base.lower()


def grouped(items):
    """Regroupe les secrets en entrées logiques.

    Retourne [(kind, base, user, value, exported)] où kind vaut :
      "pair"   NOM_USER + NOM_PASSWORD
      "aws"    AWS_<PROFIL>_ACCESS_KEY_ID + _SECRET_ACCESS_KEY, hors environnement
      "single" tout le reste
    """
    d = {n: v for n, v, _ in items}
    exp = {n: e for n, _, e in items}
    out, used = [], set()
    for n in sorted(d):
        if n.endswith("_USER") and (n[:-5] + "_PASSWORD") in d:
            base = n[:-5]
            out.append(("pair", base, d[n], d[base + "_PASSWORD"], exp[n]))
            used.update({n, base + "_PASSWORD"})
        elif (n.startswith("AWS_") and n.endswith(AWS_ID_SUFFIX) and not exp[n]
              and (n[:-len(AWS_ID_SUFFIX)] + AWS_SECRET_SUFFIX) in d):
            base = n[:-len(AWS_ID_SUFFIX)]
            out.append(("aws", base, d[n], d[base + AWS_SECRET_SUFFIX], False))
            used.update({n, base + AWS_SECRET_SUFFIX, base + "_SESSION_TOKEN"})
    for n in sorted(d):
        if n not in used:
            out.append(("single", n, None, d[n], exp[n]))
    return sorted(out, key=lambda r: r[1])


def save_pair(base, user, password):
    store_set(base + "_USER", user)
    store_set(base + "_PASSWORD", password)


def delete_entry(kind, base):
    if kind == "pair":
        store_del(base + "_USER")
        store_del(base + "_PASSWORD")
    elif kind == "aws":
        for suffix in (AWS_ID_SUFFIX, AWS_SECRET_SUFFIX, "_SESSION_TOKEN"):
            store_del(base + suffix)
    else:
        store_del(base)


