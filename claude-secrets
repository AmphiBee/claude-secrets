            self.toasts.add_toast(Adw.Toast(title=text, timeout=3))

        def mask(self, value, key):
            return value if key in self.revealed else MASK

        def clear(self):
            child = self.box.get_first_child()
            while child:
                nxt = child.get_next_sibling()
                self.box.remove(child)
                child = nxt

        def reload(self):
            self.clear()
            if self.needs_setup:
                self.title.set_subtitle("")
                self.add_btn.set_sensitive(False)
                self.show_welcome()
                return
            self.add_btn.set_sensitive(True)

            entries = grouped(store_all())
            self.entries = {f"{e[0]}|{e[1]}": e for e in entries}
            total = len(entries)
            self.title.set_subtitle(plural(total, "secret") if total else "")

            q = self.search.get_text().strip().lower()
            if q:
                entries = [e for e in entries
                           if q in e[1].lower() or q in (e[2] or "").lower()]

            if not total:
                self.show_empty()
                return
            if not entries:
                self.box.append(Adw.StatusPage(
                    icon_name="system-search-symbolic", vexpand=True,
                    title="Aucun résultat",
                    description=f"Aucun secret ne correspond à « {q} »."))
                return

            if not q:
                self.box.append(self.hero(total))

            sections = [
                ("Clés et tokens",
                 "Disponibles dans le terminal comme variables d'environnement.",
                 lambda e: e[0] == "single" and e[4], self.make_single_row),
                ("Identifiants",
                 "Exposés en deux variables : _USER et _PASSWORD.",
                 lambda e: e[0] == "pair", self.make_pair_row),
                ("AWS",
                 "Servis à l'AWS CLI via credential_process, hors environnement.",
                 lambda e: e[0] == "aws", self.make_aws_row),
                ("Hors environnement",
                 "Conservés chiffrés, jamais injectés dans le terminal.",
                 lambda e: e[0] == "single" and not e[4], self.make_single_row),
            ]
            for title, desc, keep, build in sections:
                rows = [e for e in entries if keep(e)]
                if not rows:
                    continue
                grp = Adw.PreferencesGroup(title=title, description=desc)
                for e in rows:
                    grp.add(build(e))
                self.box.append(grp)

