        def edit_dialog(self, kind=None, base=None, user=None, value="",
                        exported=True):
            editing = base is not None
            dlg = Adw.MessageDialog(
                transient_for=self, modal=True,
                heading=f"Modifier {base}" if editing else "Nouveau secret")

            grp = Adw.PreferencesGroup(margin_top=12)
            combo = Adw.ComboRow(
                title="Type",
                model=Gtk.StringList.new(["Clé ou token",
                                          "Identifiant + mot de passe"]))
            combo.set_selected(1 if kind == "pair" else 0)
            combo.set_visible(not editing)
            grp.add(combo)

            name_row = Adw.EntryRow(title="Nom de la variable")
            name_row.set_text(base or "")
            name_row.set_visible(not editing)
            grp.add(name_row)

            user_row = Adw.EntryRow(title="Identifiant")
            user_row.set_text(user or "")
            grp.add(user_row)

            val_row = Adw.PasswordEntryRow(title="Mot de passe")
            val_row.set_text(value)
            grp.add(val_row)

            hint = Gtk.Label(wrap=True, margin_top=12, xalign=0)
            hint.add_css_class("dim-label")
            hint.add_css_class("caption")

            def normalized():
                return (name_row.get_text().strip().upper()
                        .replace("-", "_").replace(" ", "_"))

            def sync(*_):
                pair = combo.get_selected() == 1
                user_row.set_visible(pair)
                val_row.set_title("Mot de passe" if pair else "Valeur")
                n = normalized() or "NOM"
                if not exported:
                    hint.set_text("Secret hors environnement : il reste invisible "
                                  "dans le terminal.")
                else:
                    hint.set_text(f"Variables créées : ${n}_USER et ${n}_PASSWORD"
                                  if pair else f"Variable créée : ${n}")
            combo.connect("notify::selected", sync)
            name_row.connect("changed", sync)
            sync()

            wrap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            wrap.append(grp)
            wrap.append(hint)
            dlg.set_extra_child(wrap)

            dlg.add_response("cancel", "Annuler")
            dlg.add_response("save", "Enregistrer")
            dlg.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)
            dlg.set_default_response("save")
            dlg.set_close_response("cancel")

            def done(d, resp):
                if resp != "save":
                    return
                pair = combo.get_selected() == 1
                n = base if editing else normalized()
                v = val_row.get_text()
                if not NAME_RE.match(n):
                    self.toast("Nom invalide : majuscules, chiffres et _")
                    return
                if pair and n.endswith(("_USER", "_PASSWORD")):
                    self.toast("Donne le nom de base, sans _USER ni _PASSWORD")
                    return
                if not v:
                    self.toast("Valeur vide, rien n'a été enregistré")
                    return
                if pair:
                    u = user_row.get_text().strip()
                    if not u:
                        self.toast("Identifiant vide")
                        return
                    save_pair(n, u, v)
                    sets = [(n + "_USER", u, True), (n + "_PASSWORD", v, True)]
                else:
                    # Conserver le statut d'export : modifier un secret hors
                    # environnement ne doit pas le faire entrer dans le terminal.
                    store_set(n, v, export=exported)
                    sets = [(n, v, exported)]
                self.commit(sets=sets)
                if pair or exported:
                    self.toast_source(f"{n} enregistré · disponible dans les "
                                      "nouveaux terminaux")
                else:
                    self.toast(f"{n} enregistré")
            dlg.connect("response", done)
            dlg.present()

        def confirm_delete(self, target):
            e = self.entries.get(target)
            if not e:
                return
            kind, base = e[0], e[1]
            if kind != "aws":
                self.delete_with_undo(kind, base)
                return
            label = f"le profil AWS « {aws_profile_label(base)} »"
            body = ("Les clés seront retirées du trousseau. Pense à retirer "
                    "aussi la ligne credential_process de ~/.aws/config.")
            dlg = Adw.MessageDialog(transient_for=self, modal=True,
                                    heading=f"Supprimer {label} ?", body=body)
            dlg.add_response("cancel", "Annuler")
            dlg.add_response("del", "Supprimer")
            dlg.set_response_appearance("del", Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_close_response("cancel")

            def done(d, resp):
                if resp == "del":
                    delete_entry(kind, base)
                    self.expanded.discard(base)
                    self.commit(dels=entry_names(kind, base))
                    self.toast("Supprimé")
            dlg.connect("response", done)
            dlg.present()

        def delete_with_undo(self, kind, base):
            """Supprime tout de suite, avec un toast pour revenir en arrière."""
            snaps = []
            for n in entry_names(kind, base):
                snap = store_snapshot(n)
                if snap:
                    snaps.append((n, *snap))
            delete_entry(kind, base)
            self.expanded.discard(base)
            self.commit(dels=entry_names(kind, base))

            self.trash_id += 1
            key = str(self.trash_id)
            self.trash[key] = snaps

            def forget():
                self.trash.pop(key, None)   # la valeur ne reste pas en mémoire
                return False
            GLib.timeout_add_seconds(60, forget)

            toast = Adw.Toast(title=f"{base} supprimé", timeout=8,
                              button_label="Annuler", action_name="win.undo")
            toast.set_action_target_value(GLib.Variant.new_string(key))
            self.toasts.add_toast(toast)

        def undo_delete(self, key):
            snaps = self.trash.pop(key, None)
            if not snaps:
                self.toast("Trop tard : suppression définitive")
                return
            for name, value, exported, source in snaps:
                store_set(name, value, export=exported, source=source)
            self.commit(sets=[(n, v, e) for n, v, e, _ in snaps])
            self.toast("Secret restauré")

        # ── groupe choisi à la main ──

        def group_dialog(self, target):
            e = self.entries.get(target)
            if not e or not self.taxo:
                return
            base = e[1]
            mine = dict(self.group_overrides)
            auto = Taxonomy(self.data, self.domains,
                            {k: v for k, v in mine.items() if k != base}
                            ).label_of(base)
            dlg = Adw.MessageDialog(
                transient_for=self, modal=True, heading=f"Groupe de {base}",
                body="Choisis un groupe existant ou saisis un nouveau nom. "
                     "« Automatique » revient au classement d'après le nom.")
            labels = sorted({g["label"] for g in self.taxo.group(self.data)
                             if g["kind"] in ("service", "project")}, key=str.lower)
            combo = Adw.ComboRow(title="Groupes existants",
                                 model=Gtk.StringList.new(labels))
            combo.set_selected(Gtk.INVALID_LIST_POSITION)
            entry = Adw.EntryRow(title="Nom du groupe")
            entry.set_text(mine.get(base) or auto)
            combo.connect("notify::selected", lambda c, _p: (
                entry.set_text(labels[c.get_selected()])
                if c.get_selected() < len(labels) else None))
            grp = Adw.PreferencesGroup(margin_top=12)
            grp.add(combo)
            grp.add(entry)
            dlg.set_extra_child(grp)
            dlg.add_response("cancel", "Annuler")
            if base in mine:
                dlg.add_response("auto", "Automatique")
            dlg.add_response("save", "Enregistrer")
            dlg.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)
            dlg.set_default_response("save")
            dlg.set_close_response("cancel")

            def done(d, resp):
                if resp not in ("save", "auto"):
                    return
                label = entry.get_text().strip()[:60] if resp == "save" else ""
                if not label or _norm(label) == _norm(auto):
                    mine.pop(base, None)    # rien à forcer : le classement suffit
                else:
                    mine[base] = label
                self.set_group_overrides(mine)
                self.toast(f"{base} → {mine[base]}" if base in mine
                           else f"{base} : classement automatique")
            dlg.connect("response", done)
            dlg.present()

        def set_group_overrides(self, overrides):
            live = {e[1] for e in self.data or []}      # purge les entrées disparues
            self.group_overrides = {k: v for k, v in overrides.items() if k in live}
            state_update(groups=self.group_overrides)
            self.regroup()

        # ── import d'un .env ──

        def import_dialog(self):
            dlg = Adw.MessageDialog(
                transient_for=self, modal=True, heading="Importer un .env",
                body="Colle le contenu du fichier : une ligne NOM=valeur par "
                     "secret. Les secrets existants du même nom sont remplacés.")
            view = Gtk.TextView(monospace=True, top_margin=8, bottom_margin=8,
                                left_margin=8, right_margin=8)
            scroll = Gtk.ScrolledWindow(min_content_height=180,
                                        min_content_width=420, child=view)
            scroll.add_css_class("card")
            hint = Gtk.Label(xalign=0, margin_top=8)
            hint.add_css_class("dim-label")
            hint.add_css_class("caption")
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            box.append(scroll)
            box.append(hint)
            dlg.set_extra_child(box)

            existing = set()
            for kind, base, *_ in (self.data or []):
                existing.update({base + "_USER", base + "_PASSWORD"}
                                if kind == "pair" else {base})

            def items():
                buf = view.get_buffer()
                return parse_env(buf.get_text(buf.get_start_iter(),
                                              buf.get_end_iter(), False))

            def changed(*_):
                found = items()
                if not found:
                    hint.set_text("Aucune ligne NOM=valeur reconnue.")
                else:
                    replaced = sum(1 for n, _ in found if n in existing)
                    text = plural(len(found), "secret") + " détecté" \
                        + ("s" if len(found) > 1 else "")
                    if replaced:
                        text += f", dont {replaced} remplacé" \
                            + ("s" if replaced > 1 else "")
                    hint.set_text(text)
                dlg.set_response_enabled("import", bool(found))
            view.get_buffer().connect("changed", changed)

            dlg.add_response("cancel", "Annuler")
            dlg.add_response("import", "Importer")
            dlg.set_response_appearance("import", Adw.ResponseAppearance.SUGGESTED)
            dlg.set_close_response("cancel")
            changed()

            def done(d, resp):
                if resp != "import":
                    return
                found = items()
                for name, value in found:
                    store_set(name, value)
                self.commit(sets=[(n, v, True) for n, v in found])
                self.toast_source(f"{plural(len(found), 'secret')} importé"
                                  + ("s" if len(found) > 1 else ""))
            dlg.connect("response", done)
            dlg.present()

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID)
            quit_ = Gio.SimpleAction.new("quit", None)
            quit_.connect("activate", lambda *_: self.quit())
            self.add_action(quit_)
            self.win = None

        def do_startup(self):
            Adw.Application.do_startup(self)
            display = Gdk.Display.get_default()
            Gtk.IconTheme.get_for_display(display).add_search_path(
                str(runtime_icon_dir()))
            css = Gtk.CssProvider()
            style = Adw.StyleManager.get_default()

            def apply_theme(*_):
                text = theme_css(style.get_dark())
                if hasattr(css, "load_from_string"):      # GTK ≥ 4.12
                    css.load_from_string(text)
                else:                          # GTK 4.10 (Zorin 17, Ubuntu 23.x)
                    css.load_from_data(text, -1)
            apply_theme()
            style.connect("notify::dark", apply_theme)     # suit le système
            Gtk.StyleContext.add_provider_for_display(
                display, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            Gtk.Window.set_default_icon_name(APP_ID)

        def do_activate(self):
            if self.win is None:
                self.win = Win(self)
                self.win.present()
            else:
                self.win.reappear()

    App().run([])


def gui_error(message):
    """Fenêtre minimale expliquant pourquoi l'application ne peut pas démarrer."""
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Gtk, Adw

    class App(Adw.Application):
        def do_activate(self):
            win = Adw.ApplicationWindow(application=self, title="Claude Secrets",
                                        default_width=520, default_height=380)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            box.append(Adw.HeaderBar())
            box.append(Adw.StatusPage(
                icon_name="dialog-warning-symbolic", vexpand=True,
                title="Trousseau indisponible", description=message))
            win.set_icon_name(APP_ID)
            win.set_content(box)
            win.present()

    App(application_id=APP_ID).run([])


if __name__ == "__main__":
    args = sys.argv[1:]
    # `install`, `doctor` et l'aide ne touchent pas au trousseau : ils doivent
    # fonctionner même sur une machine pas encore configurée.
    if args and args[0] in ("install", "doctor", "help", "--help", "-h"):
        cli(args)
    else:
        err = service_error()
        if err:
            if args:
                sys.exit("Erreur : " + err)
            gui_error(err)
        elif args:
            cli(args)
        else:
            gui()
