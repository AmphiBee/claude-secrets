        def expander(self, kind, base, title, subtitle, avatar_text, details,
                     force_open=False):
            """Ligne dépliable dont le détail n'est construit qu'à l'ouverture.

            Sur un gros coffre, bâtir d'avance trois sous-lignes par entrée
            coûtait l'essentiel du temps d'affichage.
            """
            exp = Adw.ExpanderRow(title=title, subtitle=subtitle)
            exp.add_prefix(self.avatar(avatar_text))
            exp.filled = False

            def fill():
                if exp.filled:
                    return
                exp.filled = True
                for row in details():
                    exp.add_row(row)

            def toggled(r, _p):
                if r.get_expanded():
                    fill()
                    self.expanded.add(base)
                else:
                    self.expanded.discard(base)

            handler = exp.connect("notify::expanded", toggled)
            if base in self.expanded:
                fill()
                exp.set_expanded(True)
            elif force_open:                # résultats de recherche : on ne
                exp.handler_block(handler)  # mémorise pas cette ouverture
                fill()
                exp.set_expanded(True)
                exp.handler_unblock(handler)
            return exp

