        def auto_sync(self, force=False):
            """Synchronisation Bitwarden silencieuse (lancement, réouverture).

            Elle ne demande jamais le mot de passe maître et ne supprime rien :
            coffre verrouillé, elle propose seulement de le déverrouiller.
            """
            if self.syncing or self.needs_setup or self.parked:
                return
            conf = bw_conf()
            if not conf.get("email") or not conf.get("auto_sync", True):
                return
            if (not force and self.last_sync
                    and time.monotonic() - self.last_sync < AUTO_SYNC_EVERY):
                return
            self.bw_run_sync(None, auto=True)

        def bw_run_sync(self, password, auto=False):
            """La synchronisation parle au réseau : elle tourne hors interface."""
            import threading
            if self.syncing:
                if not auto:
                    self.toast("Une synchronisation est déjà en cours")
                return
            self.syncing = True
            self.last_sync = time.monotonic()
            if not auto:
                self.toast("Synchronisation Bitwarden…")

            def work():
                try:
                    report = bw_sync(password=password)
                except BwLocked:
                    GLib.idle_add(self.bw_locked, auto)
                    return
                except BwError as e:
                    GLib.idle_add(self.bw_failed,
                                  f"Bitwarden : {e}".split("\n")[0], auto)
                    return
                except Exception as e:
                    GLib.idle_add(self.bw_failed, f"Échec : {e}", auto)
                    return
                GLib.idle_add(self.bw_done, report, auto)

            threading.Thread(target=work, daemon=True).start()

        def bw_locked(self, auto):
            self.syncing = False
            if not auto:
                self.bw_ask_password()
                return False
            self.toasts.add_toast(Adw.Toast(
                title="Bitwarden verrouillé : synchronisation en attente",
                timeout=8, button_label="Déverrouiller",
                action_name="win.bwsync"))
            return False

        def bw_failed(self, message, auto):
            self.syncing = False
            if auto:                      # une seule alerte par session
                if self.auto_error_shown:
                    return False
                self.auto_error_shown = True
            self.toast(message)
            return False

        def bw_done(self, report, auto=False):
            self.syncing = False
            changed = (len(report["added"]) + len(report["updated"])
                       + len(report["removed"]))
            if report.get("domains_changed"):
                self.domains = state_get("domains", {}) or {}
                if not changed:
                    self.regroup()        # le classement peut changer seul
            if auto and not changed:
                return False              # rien à signaler, rien à reconstruire
            if changed:
                # On n'applique que ce que la synchro a changé : une modification
                # faite pendant ce temps dans l'application ne doit pas être
                # écrasée par la photo du trousseau prise au départ.
                values = {n: (v, e) for n, v, e in report["items"]}
                self.commit(sets=[(n, *values[n])
                                  for n in report["added"] + report["updated"]
                                  if n in values],
                            dels=report["removed"])
            if not changed:
                self.toast(f"Bitwarden à jour · {report['total']} secret(s)")
                return False
            parts = []
            for label, names in (("ajouté", report["added"]),
                                 ("mis à jour", report["updated"]),
                                 ("supprimé", report["removed"])):
                if names:
                    parts.append(f"{len(names)} {label}{'s' if len(names) > 1 else ''}")
            self.toast("Bitwarden · " + ", ".join(parts))
            return False

