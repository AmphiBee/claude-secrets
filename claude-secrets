def plural(n, word):
    return f"{n} {word}" + ("s" if n > 1 else "")


def runtime_icon_dir():
    """Rend l'icône disponible même quand l'app tourne depuis le dépôt."""
    d = pathlib.Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "claude-secrets-icons"
    try:
        d.mkdir(parents=True, exist_ok=True)
        f = d / f"{APP_ID}.svg"
        if not f.exists() or f.read_text() != ICON_SVG:
            f.write_text(ICON_SVG)
    except OSError:
        pass
    return d


