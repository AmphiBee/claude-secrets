            dlg.connect("response", lambda d, r:
                        self.bw_run_sync(row.get_text()) if r == "ok" else None)
            dlg.present()

        def bw_run_sync(self, password):
            """La synchronisation parle au réseau : elle tourne hors interface."""
            import threading
            self.toast("Synchronisation Bitwarden…")

            def work():
                try:
                    report = bw_sync(password=password)
                except BwLocked:
                    GLib.idle_add(self.bw_ask_password)
                    return
                except BwError as e:
                    GLib.idle_add(self.toast, f"Bitwarden : {e}".split("\n")[0])
                    return
                except Exception as e:
                    GLib.idle_add(self.toast, f"Échec : {e}")
                    return
                GLib.idle_add(self.bw_done, report)

            threading.Thread(target=work, daemon=True).start()

        def bw_done(self, report):
            self.reload()
            changed = (len(report["added"]) + len(report["updated"])
                       + len(report["removed"]))
            if not changed:
                self.toast(f"Bitwarden à jour · {report['total']} secret(s)")
                return
            parts = []
            for label, names in (("ajouté", report["added"]),
                                 ("mis à jour", report["updated"]),
                                 ("supprimé", report["removed"])):
                if names:
                    parts.append(f"{len(names)} {label}{'s' if len(names) > 1 else ''}")
            self.toast("Bitwarden · " + ", ".join(parts))

