        def find_label(self, widget, css_class):
            child = widget.get_first_child()
            while child:
                if isinstance(child, Gtk.Label) and child.has_css_class(css_class):
                    return child
                found = self.find_label(child, css_class)
                if found:
                    return found
                child = child.get_next_sibling()
            return None

