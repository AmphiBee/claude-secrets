#!/usr/bin/python3
"""
Claude Secrets — gestion des clés API, tokens et mots de passe pour Claude Code.

Stockage : trousseau GNOME (chiffré au repos, déverrouillé à la session).
Usage GUI : claude-secrets
Usage CLI : claude-secrets list|get|set|rm|export|import
"""
import os, re, sys, shlex, pathlib

import gi
gi.require_version("Secret", "1")
from gi.repository import Secret, GLib

APP_ID = "fr.amphibee.ClaudeSecrets"
SCHEMA = Secret.Schema.new(
    APP_ID, Secret.SchemaFlags.NONE, {
        "name": Secret.SchemaAttributeType.STRING,
        "app": Secret.SchemaAttributeType.STRING,
        "export": Secret.SchemaAttributeType.STRING,
    }
)
# Marqueur d'appartenance : isole strictement nos entrées de celles des autres
# applications qui partagent le trousseau (Railway, Docker, navigateurs...).
OWNER = "claude-secrets"


def _attrs(name):
    return {"name": name, "app": OWNER}
NAME_RE = re.compile(r"^[A-Z][A-Z0-9_]*$")
LEGACY = pathlib.Path.home() / ".claude/secrets.env"
CACHE = pathlib.Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "claude-secrets.env"

HOME = pathlib.Path.home()
ZSHRC = HOME / ".zshrc"
BASHRC = HOME / ".bashrc"
CLAUDE_MD = HOME / ".claude/CLAUDE.md"
SETTINGS = HOME / ".claude/settings.json"
DESKTOP = HOME / ".local/share/applications/fr.amphibee.ClaudeSecrets.desktop"
STATE = HOME / ".config/claude-secrets/state.json"

BEGIN = "# >>> claude-secrets >>>"
END = "# <<< claude-secrets <<<"
MD_BEGIN = "<!-- claude-secrets:début -->"
MD_END = "<!-- claude-secrets:fin -->"

ZSHRC_LINE = ('[ -r "$XDG_RUNTIME_DIR/claude-secrets.env" ] '
              '&& source "$XDG_RUNTIME_DIR/claude-secrets.env" '
              '|| eval "$(claude-secrets export 2>/dev/null)"')

SHELL_BLOCK = f"""{BEGIN}
# Secrets (clés API, tokens, identifiants) — trousseau GNOME chiffré.
# Gestion : lancer `claude-secrets` (ou l'app « Claude Secrets »).
[ -d "$HOME/.local/bin" ] && case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
{ZSHRC_LINE}
{END}"""

CLAUDE_MD_BLOCK = f"""{MD_BEGIN}
# Gestion des secrets

Les clés API, tokens et mots de passe sont stockés **chiffrés dans le trousseau
GNOME**, gérés par l'application `Claude Secrets` (commande `claude-secrets`).

Ils sont exposés comme variables d'environnement dans chaque shell — donc
disponibles directement dans les commandes Bash.

Un couple identifiant/mot de passe est stocké comme deux variables :
`NOM_USER` et `NOM_PASSWORD` (ex. `curl -u "$CLIENTX_WP_USER:$CLIENTX_WP_PASSWORD"`).

Règles, sans exception :

- Utiliser les secrets **uniquement par substitution shell** : `$NOM_DE_LA_CLE`
  ou `"$NOM_DE_LA_CLE"` dans la commande. La valeur est résolue par bash, jamais
  lue ni recopiée.
- **Ne jamais afficher la valeur d'un secret** : pas de `echo $TOKEN`, pas de
  `printenv`, pas de `env`, pas de `claude-secrets get`, pas de `cat` sur un
  `.env` ou sur le cache `$XDG_RUNTIME_DIR/claude-secrets.env`.
- Ne jamais écrire une valeur de secret dans un fichier, un commit, un message,
  ou dans la conversation.
- Pour connaître les secrets disponibles, lire **les noms seulement** :
  `claude-secrets list`
- Pour vérifier qu'une variable est définie sans la révéler :
  `[ -n "$TOKEN" ] && echo "définie (${{#TOKEN}} caractères)"`
- Avec `curl`, préférer `-H "Authorization: Bearer $TOKEN"` et éviter `-v` /
  `--trace` qui impriment les en-têtes envoyés.
- Si un secret manque, proposer à l'utilisateur de l'ajouter via l'app `Claude Secrets`
  ou `claude-secrets set NOM` — ne jamais lui demander de le coller dans le chat.
- Un secret ajouté **pendant** la session n'est pas dans l'environnement figé au
  démarrage. Dans ce cas, préfixer la commande par un rechargement du cache :
  `source "$XDG_RUNTIME_DIR/claude-secrets.env" && <commande utilisant $NOM>`
{MD_END}"""

DENY_RULES = [
    f"Read(/{CACHE})",
    "Read(**/.env)", "Read(**/.env.*)",
    "Bash(env)", "Bash(env:*)", "Bash(printenv:*)", "Bash(export -p)",
    "Bash(claude-secrets get:*)", "Bash(claude-secrets export)",
]

DESKTOP_ENTRY = """[Desktop Entry]
Type=Application
Name=Claude Secrets
GenericName=Gestionnaire de clés API
Comment=Gérer les clés API, tokens et mots de passe utilisés par Claude Code
Exec={exe}
Icon=dialog-password
Terminal=false
Categories=Utility;Security;Development;
Keywords=secret;api;token;password;clé;mot de passe;claude;
StartupNotify=true
StartupWMClass=fr.amphibee.ClaudeSecrets
"""


# ─────────────────────────── stockage ───────────────────────────

def store_set(name, value, export=True):
    """Enregistre un secret.

    export=False : conservé dans le trousseau mais JAMAIS exposé comme variable
    d'environnement (cas des identifiants AWS, servis via credential_process).
    """
    # Purge préalable : garantit qu'un nom ne peut pas exister en double, même
    # si les attributs secondaires ont changé entre deux versions.
    Secret.password_clear_sync(SCHEMA, _attrs(name), None)
    return Secret.password_store_sync(
        SCHEMA, {**_attrs(name), "export": "1" if export else "0"},
        Secret.COLLECTION_DEFAULT, f"Claude Secrets — {name}", value, None)


def store_get(name):
    return Secret.password_lookup_sync(SCHEMA, _attrs(name), None)


def store_del(name):
    return Secret.password_clear_sync(SCHEMA, _attrs(name), None)


def store_all(only_exported=False):
    """[(name, value, exported)] trié par nom."""
    flags = (Secret.SearchFlags.ALL | Secret.SearchFlags.UNLOCK
             | Secret.SearchFlags.LOAD_SECRETS)
    out = []
    for item in Secret.password_search_sync(SCHEMA, {"app": OWNER}, flags, None):
        a = item.get_attributes()
        name = a.get("name")
        if not name or a.get("app") != OWNER:
            continue
        exported = a.get("export", "1") != "0"
        if only_exported and not exported:
            continue
        try:
            sec = item.retrieve_secret_sync(None)
            out.append((name, sec.get_text() if sec else "", exported))
        except GLib.Error:
            pass
    return sorted(set(out))


def refresh_cache():
    """Cache en tmpfs (RAM) pour un démarrage de shell instantané."""
    try:
        lines = [f"export {n}={shlex.quote(v)}"
                 for n, v, _ in store_all(only_exported=True)]
        tmp = CACHE.with_suffix(".tmp")
        tmp.write_text("\n".join(lines) + ("\n" if lines else ""))
        tmp.chmod(0o600)
        tmp.replace(CACHE)
    except Exception:
        pass


def service_error():
    """Message d'erreur si le trousseau est inutilisable, sinon None."""
    if not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        return ("Aucune session D-Bus détectée.\n\n"
                "Claude Secrets a besoin d'une session graphique ouverte. "
                "En SSH, ouvre d'abord une session sur la machine.")
    try:
        Secret.Service.get_sync(Secret.ServiceFlags.NONE, None)
    except GLib.Error as e:
        return ("Aucun service de trousseau n'est disponible.\n\n"
                "Installe puis ouvre une session avec :\n"
                "  \u2022 GNOME / Zorin / Ubuntu : gnome-keyring\n"
                "  \u2022 KDE : kwalletmanager (avec le greffon Secret Service)\n\n"
                f"D\u00e9tail : {e.message}")
    return None


# ─────────────────────────── installation ───────────────────────────

def _strip_block(text, begin, end):
    """Retire un bloc délimité, s'il existe."""
    if begin in text and end in text:
        a, b = text.index(begin), text.index(end) + len(end)
        text = text[:a].rstrip("\n") + "\n" + text[b:].lstrip("\n")
    return text


LEGACY_SHELL = [
    '# Secrets (API keys, tokens) — trousseau GNOME via `claude-secrets`',
    '# Secrets (API keys, tokens) — fichier en chmod 600',
]


def _clean_shell(text):
    """Retire le bloc marqué et les anciennes variantes non marquées."""
    text = _strip_block(text, BEGIN, END)
    out, skip = [], 0
    for line in text.splitlines():
        if skip:
            skip -= 1
            if line.rstrip().endswith("\\"):
                skip += 1
            continue
        if line.strip() in LEGACY_SHELL:
            skip = 1
            continue
        if "claude-secrets" in line or "$HOME/.claude/secrets.env" in line:
            if line.rstrip().endswith("\\"):
                skip = 1
            continue
        out.append(line)
    return "\n".join(out).rstrip("\n") + "\n"


def shell_rc():
    """Fichier de config du shell de connexion."""
    sh = os.environ.get("SHELL", "")
    if "zsh" in sh and ZSHRC.exists():
        return ZSHRC
    if "bash" in sh and BASHRC.exists():
        return BASHRC
    return ZSHRC if ZSHRC.exists() else BASHRC


def detect():
    """État de l'installation, sans rien modifier."""
    rc = shell_rc()
    st = {"shell_rc": rc, "shell": False, "claude_md": False,
          "settings": False, "desktop": False, "bin": False}
    try:
        st["shell"] = rc.exists() and BEGIN in rc.read_text()
    except OSError:
        pass
    try:
        st["claude_md"] = CLAUDE_MD.exists() and MD_BEGIN in CLAUDE_MD.read_text()
    except OSError:
        pass
    try:
        import json as _j
        deny = _j.loads(SETTINGS.read_text()).get("permissions", {}).get("deny", [])
        st["settings"] = all(r in deny for r in DENY_RULES)
    except Exception:
        pass
    st["desktop"] = DESKTOP.exists()
    st["bin"] = (HOME / ".local/bin/claude-secrets").exists()
    st["complete"] = all(st[k] for k in ("shell", "claude_md", "settings", "desktop"))
    return st


def backup(path):
    if path.exists():
        import shutil, time
        b = path.with_name(path.name + ".bak-" + time.strftime("%Y%m%d%H%M%S"))
        shutil.copy2(path, b)
        return b
    return None


def install():
    """Déploie l'intégration dans le dossier personnel. Idempotent."""
    import json, shutil
    log = []

    # 1. Binaire dans ~/.local/bin
    target = HOME / ".local/bin/claude-secrets"
    src = pathlib.Path(__file__).resolve()
    target.parent.mkdir(parents=True, exist_ok=True)
    if src != target.resolve():
        shutil.copy2(src, target)
        target.chmod(0o755)
        log.append(f"Commande installée dans {target}")

    # 2. Shell
    rc = shell_rc()
    rc.parent.mkdir(parents=True, exist_ok=True)
    old = rc.read_text() if rc.exists() else ""
    new = _clean_shell(old) + "\n" + SHELL_BLOCK + "\n"
    if new != old:
        backup(rc)
        rc.write_text(new)
        log.append(f"Chargement des secrets ajouté à {rc.name}")

    # 3. Règles pour Claude Code
    CLAUDE_MD.parent.mkdir(parents=True, exist_ok=True)
    old = CLAUDE_MD.read_text() if CLAUDE_MD.exists() else ""
    base = _strip_block(old, MD_BEGIN, MD_END)
    if base.lstrip().startswith("# Gestion des secrets"):
        base = ""  # ancienne version non marquée, écrite par ce même outil
    new = (base.rstrip("\n") + "\n\n" if base.strip() else "") + CLAUDE_MD_BLOCK + "\n"
    if new != old:
        backup(CLAUDE_MD)
        CLAUDE_MD.write_text(new)
        log.append(f"Règles de manipulation écrites dans {CLAUDE_MD}")

    # 4. Garde-fous dans settings.json
    try:
        d = json.loads(SETTINGS.read_text()) if SETTINGS.exists() else {}
    except (json.JSONDecodeError, OSError):
        d = {}
    deny = d.setdefault("permissions", {}).setdefault("deny", [])
    added = [r for r in DENY_RULES if r not in deny]
    if added:
        backup(SETTINGS)
        deny.extend(added)
        SETTINGS.parent.mkdir(parents=True, exist_ok=True)
        SETTINGS.write_text(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
        log.append(f"{len(added)} garde-fou(s) ajouté(s) à settings.json")

    # 5. Lanceur dans le menu
    DESKTOP.parent.mkdir(parents=True, exist_ok=True)
    entry = DESKTOP_ENTRY.format(exe=target)
    if not DESKTOP.exists() or DESKTOP.read_text() != entry:
        DESKTOP.write_text(entry)
        log.append("Lanceur « Claude Secrets » ajouté au menu")
        os.system("update-desktop-database "
                  f"{shlex.quote(str(DESKTOP.parent))} 2>/dev/null")

    # 6. Mémoriser
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps({"installed": True, "version": 1}) + "\n")

    refresh_cache()
    return log or ["Déjà configuré — rien à changer."]


# ─────────────────────────── AWS ───────────────────────────
#
# Les identifiants AWS ne doivent PAS devenir des variables d'environnement :
# elles écraseraient globalement le profil par défaut et rendraient le
# comportement de `--profile` imprévisible. On les stocke donc hors
# environnement (export=False) et on les sert à la demande via le mécanisme
# `credential_process`, compris nativement par l'AWS CLI, les SDK et Terraform.

AWS_DIR = HOME / ".aws"
AWS_CREDS = AWS_DIR / "credentials"
AWS_CONFIG = AWS_DIR / "config"


def aws_key(profile, field):
    """Nom de stockage pour un champ de profil AWS."""
    slug = re.sub(r"[^A-Z0-9]+", "_", profile.upper()).strip("_")
    return f"AWS_{slug}_{field.upper()}"


def aws_profiles():
    """Profils lisibles dans ~/.aws/credentials."""
    import configparser
    if not AWS_CREDS.exists():
        return {}
    c = configparser.ConfigParser()
    c.read(AWS_CREDS)
    out = {}
    for s in c.sections():
        d = {k: v for k, v in c.items(s) if v}
        if "aws_access_key_id" in d and "aws_secret_access_key" in d:
            out[s] = d
    return out


def aws_import(activate=False):
    import configparser
    profiles = aws_profiles()
    if not profiles:
        sys.exit(f"Aucun profil exploitable dans {AWS_CREDS}.")

    for name, d in profiles.items():
        store_set(aws_key(name, "access_key_id"), d["aws_access_key_id"],
                  export=False)
        store_set(aws_key(name, "secret_access_key"), d["aws_secret_access_key"],
                  export=False)
        if d.get("aws_session_token"):
            store_set(aws_key(name, "session_token"), d["aws_session_token"],
                      export=False)
        print(f"  importé : profil « {name} » "
              f"({d['aws_access_key_id'][:4]}…{d['aws_access_key_id'][-4:]})")
    refresh_cache()
    print(f"\n{len(profiles)} profil(s) dans le trousseau, hors environnement.")

    if not activate:
        print("\nRien d'autre n'a été modifié. Pour que l'AWS CLI les lise "
              "depuis le trousseau :\n  claude-secrets aws-import --activate")
        return

    # 1. credential_process dans ~/.aws/config
    exe = HOME / ".local/bin/claude-secrets"
    cfg = configparser.ConfigParser()
    if AWS_CONFIG.exists():
        cfg.read(AWS_CONFIG)
    backup(AWS_CONFIG)
    for name in profiles:
        section = "default" if name == "default" else f"profile {name}"
        if not cfg.has_section(section):
            cfg.add_section(section)
        cfg.set(section, "credential_process", f"{exe} aws-credentials {name}")
    with open(AWS_CONFIG, "w") as fh:
        cfg.write(fh)
    AWS_CONFIG.chmod(0o600)
    print(f"\n  credential_process écrit dans {AWS_CONFIG}")

    # 2. Le fichier credentials est prioritaire : il doit être écarté.
    disabled = AWS_CREDS.with_suffix(".disabled")
    backup(AWS_CREDS)
    AWS_CREDS.rename(disabled)
    disabled.chmod(0o600)
    print(f"  {AWS_CREDS.name} renommé en {disabled.name} "
          "(il avait priorité sur credential_process)")
    print("\nVérifie avec :  aws sts get-caller-identity --profile "
          + next(iter(profiles)))


def aws_credentials(profile):
    """Sortie JSON attendue par credential_process."""
    import json as _json
    akid = store_get(aws_key(profile, "access_key_id"))
    secret = store_get(aws_key(profile, "secret_access_key"))
    if not akid or not secret:
        sys.exit(f"Profil « {profile} » absent du trousseau. "
                 "Lance : claude-secrets aws-import")
    out = {"Version": 1, "AccessKeyId": akid, "SecretAccessKey": secret}
    token = store_get(aws_key(profile, "session_token"))
    if token:
        out["SessionToken"] = token
    print(_json.dumps(out))


# ─────────────────────────── CLI ───────────────────────────

def cli(argv):
    cmd = argv[0] if argv else "help"

    if cmd == "list":
        entries = grouped(store_all())
        if not entries:
            print("(aucun secret)")
            return
        for kind, base, user, _, exported in entries:
            tag = "" if exported else "   [non exporté]"
            if kind == "pair":
                print(f"{base:<32} identifiant + mot de passe  ({user}){tag}")
            else:
                print(f"{base}{tag}")

    elif cmd == "get":
        if len(argv) < 2:
            sys.exit("usage: claude-secrets get NOM")
        v = store_get(argv[1])
        if v is None:
            sys.exit(f"'{argv[1]}' introuvable")
        print(v)

    elif cmd == "set":
        if len(argv) < 2:
            sys.exit("usage: claude-secrets set NOM [VALEUR]")
        name = argv[1]
        if not NAME_RE.match(name):
            sys.exit("Nom invalide : majuscules, chiffres et _ uniquement.")
        if len(argv) >= 3:
            value = argv[2]
        else:
            import getpass
            value = getpass.getpass(f"Valeur pour {name} (masquée) : ")
        if not value:
            sys.exit("Valeur vide, abandon.")
        store_set(name, value)
        refresh_cache()
        print(f"{name} enregistré ({len(value)} caractères).")

    elif cmd == "set-login":
        if len(argv) < 2:
            sys.exit("usage: claude-secrets set-login NOM [IDENTIFIANT]")
        name = argv[1].upper()
        if not NAME_RE.match(name):
            sys.exit("Nom invalide : majuscules, chiffres et _ uniquement.")
        if name.endswith(("_USER", "_PASSWORD")):
            sys.exit("Donne le nom de base, sans _USER ni _PASSWORD.")
        user = argv[2] if len(argv) >= 3 else input(f"Identifiant pour {name} : ").strip()
        if not user:
            sys.exit("Identifiant vide, abandon.")
        import getpass
        pw = getpass.getpass(f"Mot de passe pour {name} (masqué) : ")
        if not pw:
            sys.exit("Mot de passe vide, abandon.")
        save_pair(name, user, pw)
        refresh_cache()
        print(f"{name} enregistré → ${name}_USER et ${name}_PASSWORD")

    elif cmd == "aws-import":
        aws_import(activate="--activate" in argv)

    elif cmd == "aws-credentials":
        if len(argv) < 2:
            sys.exit("usage: claude-secrets aws-credentials PROFIL")
        aws_credentials(argv[1])

    elif cmd == "install":
        for line in install():
            print("  •", line)
        print("\nOuvre un nouveau terminal pour que les secrets soient chargés.")

    elif cmd == "doctor":
        st = detect()
        label = {"bin": "Commande claude-secrets", "shell": f"Chargement dans {st['shell_rc'].name}",
                 "claude_md": "Règles dans ~/.claude/CLAUDE.md",
                 "settings": "Garde-fous dans settings.json",
                 "desktop": "Lanceur « Claude Secrets » dans le menu"}
        for k, lbl in label.items():
            print(f"  [{'✓' if st[k] else ' '}] {lbl}")
        print()
        print("Installation complète." if st["complete"]
              else "Incomplet — lance : claude-secrets install")

    elif cmd == "rm":
        if len(argv) < 2:
            sys.exit("usage: claude-secrets rm NOM")
        name = argv[1]
        hit = store_del(name)
        if not hit and store_get(name + "_PASSWORD") is not None:
            delete_entry("pair", name)
            hit = True
            print(f"{name} supprimé (identifiant + mot de passe).")
        elif hit:
            print(f"{name} supprimé.")
        else:
            print(f"'{name}' introuvable")
        refresh_cache()

    elif cmd == "export":
        for n, v, _ in store_all(only_exported=True):
            print(f"export {n}={shlex.quote(v)}")
        refresh_cache()

    elif cmd == "import":
        src = pathlib.Path(argv[1]) if len(argv) > 1 else LEGACY
        if not src.exists():
            sys.exit(f"{src} introuvable")
        n = 0
        for line in src.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            m = re.match(r'^(?:export\s+)?([A-Z][A-Z0-9_]*)=(.*)$', line)
            if not m:
                continue
            name, raw = m.group(1), m.group(2).strip()
            if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'":
                raw = raw[1:-1]
            if raw:
                store_set(name, raw)
                n += 1
                print(f"  importé : {name}")
        refresh_cache()
        print(f"{n} secret(s) importé(s) depuis {src}.")

    else:
        print(__doc__.strip())


# ─────────────────────────── regroupement ───────────────────────────

def grouped(items):
    """Regroupe NOM_USER + NOM_PASSWORD en une entrée logique.

    Retourne [(kind, base, user, value)] où kind vaut "pair" ou "single".
    """
    d = {n: v for n, v, _ in items}
    exp = {n: e for n, _, e in items}
    out, used = [], set()
    for n in sorted(d):
        if n.endswith("_USER") and (n[:-5] + "_PASSWORD") in d:
            base = n[:-5]
            out.append(("pair", base, d[n], d[base + "_PASSWORD"], exp[n]))
            used.update({n, base + "_PASSWORD"})
    for n in sorted(d):
        if n not in used:
            out.append(("single", n, None, d[n], exp[n]))
    return sorted(out, key=lambda r: r[1])


def save_pair(base, user, password):
    store_set(base + "_USER", user)
    store_set(base + "_PASSWORD", password)


def delete_entry(kind, base):
    if kind == "pair":
        store_del(base + "_USER")
        store_del(base + "_PASSWORD")
    else:
        store_del(base)


# ─────────────────────────── GUI ───────────────────────────

def gui():
    # Les terminaux distribués en snap (Ghostty…) imposent leur propre cache de
    # loaders d'images, lié à une glibc plus récente que celle du système : les
    # icônes ne se chargent alors pas. On repasse sur les loaders du système.
    for var in ("GDK_PIXBUF_MODULE_FILE", "GDK_PIXBUF_MODULEDIR"):
        if "/snap/" in os.environ.get(var, ""):
            os.environ.pop(var, None)

    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Gtk, Adw, Gdk, Gio

    class Win(Adw.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Claude Secrets",
                             default_width=640, default_height=700)
            self.revealed = set()
            self.needs_setup = not detect()["complete"]

            self.toasts = Adw.ToastOverlay()
            self.set_content(self.toasts)
            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.toasts.set_child(root)

            hb = Adw.HeaderBar()
            add = Gtk.Button(icon_name="list-add-symbolic",
                             tooltip_text="Ajouter un secret")
            add.add_css_class("suggested-action")
            add.connect("clicked", lambda *_: self.edit_dialog())
            hb.pack_start(add)

            menu_btn = Gtk.MenuButton(icon_name="open-menu-symbolic")
            menu = Gio.Menu()
            menu.append("Vérifier l'installation", "win.setup")
            menu.append("Copier la ligne .zshrc", "win.zshrc")
            menu_btn.set_menu_model(menu)
            hb.pack_end(menu_btn)

            self.search = Gtk.SearchEntry(placeholder_text="Filtrer…", hexpand=True)
            self.search.connect("search-changed", lambda *_: self.reload())
            hb.set_title_widget(self.search)
            root.append(hb)

            act = Gio.SimpleAction.new("zshrc", None)
            act.connect("activate", lambda *_: self.copy_zshrc())
            self.add_action(act)
            act2 = Gio.SimpleAction.new("setup", None)
            act2.connect("activate", lambda *_: self.setup_dialog())
            self.add_action(act2)

            self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                               margin_top=18, margin_bottom=18,
                               margin_start=12, margin_end=12)
            scroll = Gtk.ScrolledWindow(
                vexpand=True, child=Adw.Clamp(maximum_size=580, child=self.box))
            root.append(scroll)
            self.reload()

        def toast(self, text):
            self.toasts.add_toast(Adw.Toast(title=text, timeout=3))

        def mask(self, value, key):
            return value if key in self.revealed else "•" * min(len(value), 24)

        def reload(self):
            child = self.box.get_first_child()
            while child:
                nxt = child.get_next_sibling()
                self.box.remove(child)
                child = nxt

            if self.needs_setup:
                self.show_welcome()
                return

            entries = grouped(store_all())
            q = self.search.get_text().strip().upper()
            if q:
                entries = [e for e in entries if q in e[1]]

            if not entries:
                self.box.append(Adw.StatusPage(
                    icon_name="dialog-password-symbolic", vexpand=True,
                    title="Aucun secret" if not q else "Aucun résultat",
                    description=("Clique sur + pour ajouter une clé API "
                                 "ou un identifiant." if not q
                                 else "Essaie un autre filtre.")))
                return

            grp = Adw.PreferencesGroup(
                title=f"{len(entries)} entrée" + ("s" if len(entries) > 1 else ""),
                description="Chiffrées dans le trousseau GNOME")
            for e in entries:
                grp.add(self.make_pair_row(e[1], e[2], e[3], e[4])
                        if e[0] == "pair"
                        else self.make_single_row(e[1], e[3], e[4]))
            self.box.append(grp)

        # ---- premier lancement ----

        def show_welcome(self):
            page = Adw.StatusPage(
                icon_name="dialog-password-symbolic", vexpand=True,
                title="Bienvenue",
                description=(
                    "Tes clés API, tokens et mots de passe seront chiffrés dans "
                    "le trousseau GNOME, déverrouillé automatiquement à ta "
                    "session — aucun mot de passe à retaper.\n\n"
                    "Pour que Claude Code puisse les utiliser sans jamais les "
                    "voir en clair, quelques réglages sont à déployer dans ton "
                    "dossier personnel."))

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                          halign=Gtk.Align.CENTER)
            go = Gtk.Button(label="Configurer maintenant")
            go.add_css_class("suggested-action")
            go.add_css_class("pill")
            go.connect("clicked", lambda *_: self.run_install())
            box.append(go)

            detail = Gtk.Button(label="Voir ce qui sera modifié")
            detail.add_css_class("flat")
            detail.connect("clicked", lambda *_: self.setup_dialog())
            box.append(detail)

            later = Gtk.Button(label="Plus tard")
            later.add_css_class("flat")
            later.connect("clicked", lambda *_: self.skip_setup())
            box.append(later)

            page.set_child(box)
            self.box.append(page)

        def skip_setup(self):
            self.needs_setup = False
            self.reload()
            self.toast("Tu pourras configurer via le menu ⋮")

        def setup_dialog(self):
            st = detect()
            rows = [
                ("bin", "Commande `claude-secrets`", "~/.local/bin/"),
                ("shell", f"Chargement des secrets", f"~/{st['shell_rc'].name}"),
                ("claude_md", "Règles de manipulation", "~/.claude/CLAUDE.md"),
                ("settings", "Garde-fous anti-fuite", "~/.claude/settings.json"),
                ("desktop", "Lanceur « Claude Secrets »", "menu des applications"),
            ]
            dlg = Adw.MessageDialog(
                transient_for=self, modal=True, heading="Configuration",
                body="Tout se fait dans ton dossier personnel, sans sudo. "
                     "Les fichiers existants sont sauvegardés avant modification.")
            grp = Adw.PreferencesGroup(margin_top=12)
            for key, title, where in rows:
                r = Adw.ActionRow(title=title, subtitle=where)
                r.add_prefix(Gtk.Image(
                    icon_name="emblem-ok-symbolic" if st[key]
                    else "list-add-symbolic"))
                grp.add(r)
            dlg.set_extra_child(grp)
            dlg.add_response("close", "Fermer")
            if not st["complete"]:
                dlg.add_response("go", "Installer")
                dlg.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)
                dlg.set_default_response("go")
            dlg.set_close_response("close")
            dlg.connect("response",
                        lambda d, r: self.run_install() if r == "go" else None)
            dlg.present()

        def run_install(self):
            try:
                log = install()
            except Exception as e:
                self.toast(f"Échec : {e}")
                return
            self.needs_setup = False
            self.reload()
            dlg = Adw.MessageDialog(
                transient_for=self, modal=True, heading="Configuration terminée",
                body="\n".join("• " + l for l in log) +
                     "\n\nOuvre un nouveau terminal pour que tes secrets soient "
                     "chargés dans l'environnement.")
            dlg.add_response("ok", "Parfait")
            dlg.set_response_appearance("ok", Adw.ResponseAppearance.SUGGESTED)
            dlg.present()

        # ---- boutons communs ----

        def btn(self, icon, tip, cb):
            b = Gtk.Button(icon_name=icon, valign=Gtk.Align.CENTER, tooltip_text=tip)
            b.add_css_class("flat")
            b.connect("clicked", cb)
            return b

        def make_single_row(self, name, value, exported=True):
            sub = self.mask(value, name)
            if not exported:
                sub += "   ·   non exporté"
            row = Adw.ActionRow(title=name, subtitle=sub)
            row.add_css_class("property")
            row.add_suffix(self.btn(
                "view-conceal-symbolic" if name in self.revealed
                else "view-reveal-symbolic", "Afficher / masquer",
                lambda *_: self.toggle(name)))
            row.add_suffix(self.btn("edit-copy-symbolic",
                                    "Copier (effacé après 45 s)",
                                    lambda *_: self.copy(value)))
            row.add_suffix(self.btn("document-edit-symbolic", "Modifier",
                                    lambda *_: self.edit_dialog("single", name,
                                                                None, value)))
            row.add_suffix(self.btn("user-trash-symbolic", "Supprimer",
                                    lambda *_: self.confirm_delete("single", name)))
            return row

        def make_pair_row(self, base, user, password, exported=True):
            sub = f"{user} · mot de passe"
            if not exported:
                sub += " · non exporté"
            exp = Adw.ExpanderRow(title=base, subtitle=sub)
            exp.add_prefix(Gtk.Image(icon_name="avatar-default-symbolic"))

            exp.add_action(self.btn("document-edit-symbolic", "Modifier",
                                    lambda *_: self.edit_dialog("pair", base,
                                                                user, password)))
            exp.add_action(self.btn("user-trash-symbolic", "Supprimer",
                                    lambda *_: self.confirm_delete("pair", base)))

            u = Adw.ActionRow(title="Identifiant", subtitle=user)
            u.add_css_class("property")
            u.add_suffix(self.btn("edit-copy-symbolic", "Copier l'identifiant",
                                  lambda *_: self.copy(user)))
            exp.add_row(u)

            key = base + "_PASSWORD"
            pw = Adw.ActionRow(title="Mot de passe",
                               subtitle=self.mask(password, key))
            pw.add_css_class("property")
            pw.add_suffix(self.btn(
                "view-conceal-symbolic" if key in self.revealed
                else "view-reveal-symbolic", "Afficher / masquer",
                lambda *_: self.toggle(key)))
            pw.add_suffix(self.btn("edit-copy-symbolic",
                                   "Copier (effacé après 45 s)",
                                   lambda *_: self.copy(password)))
            exp.add_row(pw)

            v = Adw.ActionRow(
                title="Variables",
                subtitle=(f"${base}_USER · ${base}_PASSWORD" if exported
                          else "aucune — secret hors environnement"))
            v.add_css_class("property")
            exp.add_row(v)
            return exp

        # ---- actions ----

        def toggle(self, key):
            self.revealed.symmetric_difference_update({key})
            self.reload()

        def copy(self, value):
            Gdk.Display.get_default().get_clipboard().set(value)
            self.toast("Copié — le presse-papier sera vidé dans 45 s")
            GLib.timeout_add_seconds(45, self._clear_clip, value)

        def _clear_clip(self, original):
            cb = Gdk.Display.get_default().get_clipboard()
            cb.read_text_async(None, lambda c, r: self._maybe_clear(c, r, original))
            return False

        def _maybe_clear(self, cb, res, original):
            try:
                if cb.read_text_finish(res) == original:
                    cb.set("")
            except GLib.Error:
                pass

        def copy_zshrc(self):
            Gdk.Display.get_default().get_clipboard().set(ZSHRC_LINE)
            self.toast("Ligne .zshrc copiée")

        def edit_dialog(self, kind=None, base=None, user=None, value=""):
            editing = base is not None
            dlg = Adw.MessageDialog(
                transient_for=self, modal=True,
                heading="Modifier" if editing else "Nouvelle entrée")

            grp = Adw.PreferencesGroup(margin_top=12)

            combo = Adw.ComboRow(
                title="Type",
                model=Gtk.StringList.new(["Clé ou token (valeur unique)",
                                          "Identifiant + mot de passe"]))
            combo.set_selected(1 if kind == "pair" else 0)
            combo.set_sensitive(not editing)
            grp.add(combo)

            name_row = Adw.EntryRow(title="Nom")
            name_row.set_text(base or "")
            name_row.set_sensitive(not editing)
            grp.add(name_row)

            user_row = Adw.EntryRow(title="Identifiant")
            user_row.set_text(user or "")
            grp.add(user_row)

            val_row = Adw.PasswordEntryRow(title="Mot de passe")
            val_row.set_text(value)
            grp.add(val_row)

            hint = Gtk.Label(wrap=True, margin_top=10, xalign=0)
            hint.add_css_class("dim-label")
            hint.add_css_class("caption")

            def sync(*_):
                pair = combo.get_selected() == 1
                user_row.set_visible(pair)
                val_row.set_title("Mot de passe" if pair else "Valeur")
                n = (name_row.get_text().strip().upper()
                     .replace("-", "_").replace(" ", "_")) or "NOM"
                hint.set_text(
                    f"Créera ${n}_USER et ${n}_PASSWORD" if pair
                    else f"Créera ${n}")
            combo.connect("notify::selected", sync)
            name_row.connect("changed", sync)
            sync()

            wrap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            wrap.append(grp)
            wrap.append(hint)
            dlg.set_extra_child(wrap)

            dlg.add_response("cancel", "Annuler")
            dlg.add_response("save", "Enregistrer")
            dlg.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)
            dlg.set_default_response("save")
            dlg.set_close_response("cancel")

            def done(d, resp):
                if resp != "save":
                    return
                pair = combo.get_selected() == 1
                n = (name_row.get_text().strip().upper()
                     .replace("-", "_").replace(" ", "_"))
                v = val_row.get_text()
                if not NAME_RE.match(n):
                    self.toast("Nom invalide : majuscules, chiffres et _")
                    return
                if pair and n.endswith(("_USER", "_PASSWORD")):
                    self.toast("Donne le nom de base, sans _USER ni _PASSWORD")
                    return
                if not v:
                    self.toast("Valeur vide — rien enregistré")
                    return
                if pair:
                    u = user_row.get_text().strip()
                    if not u:
                        self.toast("Identifiant vide")
                        return
                    save_pair(n, u, v)
                    msg = f"{n} enregistré (identifiant + mot de passe)"
                else:
                    store_set(n, v)
                    msg = f"{n} enregistré"
                refresh_cache()
                self.reload()
                self.toast(msg)
            dlg.connect("response", done)
            dlg.present()

        def confirm_delete(self, kind, base):
            body = ("Les deux variables (_USER et _PASSWORD) seront supprimées."
                    if kind == "pair" else "Cette action est définitive.")
            dlg = Adw.MessageDialog(transient_for=self, modal=True,
                                    heading=f"Supprimer {base} ?", body=body)
            dlg.add_response("cancel", "Annuler")
            dlg.add_response("del", "Supprimer")
            dlg.set_response_appearance("del", Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_close_response("cancel")

            def done(d, resp):
                if resp == "del":
                    delete_entry(kind, base)
                    refresh_cache()
                    self.reload()
                    self.toast(f"{base} supprimé")
            dlg.connect("response", done)
            dlg.present()

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID)

        def do_activate(self):
            (self.props.active_window or Win(self)).present()

    App().run([])


def gui_error(message):
    """Fenêtre minimale expliquant pourquoi l'application ne peut pas démarrer."""
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Gtk, Adw

    class App(Adw.Application):
        def do_activate(self):
            win = Adw.ApplicationWindow(application=self, title="Claude Secrets",
                                        default_width=520, default_height=380)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            box.append(Adw.HeaderBar())
            box.append(Adw.StatusPage(
                icon_name="dialog-warning-symbolic", vexpand=True,
                title="Trousseau indisponible", description=message))
            win.set_content(box)
            win.present()

    App(application_id=APP_ID).run([])


if __name__ == "__main__":
    args = sys.argv[1:]
    # `install`, `doctor` et l'aide ne touchent pas au trousseau : ils doivent
    # fonctionner même sur une machine pas encore configurée.
    if args and args[0] in ("install", "doctor", "help", "--help", "-h"):
        cli(args)
    else:
        err = service_error()
        if err:
            if args:
                sys.exit("Erreur : " + err)
            gui_error(err)
        elif args:
            cli(args)
        else:
            gui()
