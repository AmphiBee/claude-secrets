        def bw_ask_password(self):
            dlg = Adw.MessageDialog(
                transient_for=self, modal=True,
                heading="Coffre Bitwarden verrouillé",
                body="Saisis ton mot de passe maître pour déverrouiller. "
                     "Il n'est pas conservé : seule la clé de session le sera, "
                     "chiffrée dans le trousseau.")
            grp = Adw.PreferencesGroup(margin_top=12)
