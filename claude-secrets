# Chaque service a sa teinte, déduite de son nom : toujours un pastel clair, la
# lettre dans le même ton plus foncé, la bordure dans un ton intermédiaire.
TONES = 24


def tone_index(service):
    """Teinte stable d'un service (crc32, pas hash() : celui-ci change à chaque
    lancement). « Mondial Relay » et MONDIALRELAY ont la même."""
    import zlib
    letters = unicodedata.normalize("NFD", service).upper()
    return zlib.crc32(re.sub(r"[^A-Z0-9]", "", letters).encode()) % TONES


def _hsl(hue, sat, light):
    import colorsys
    r, g, b = colorsys.hls_to_rgb(hue / 360, light, sat)
    return "#%02X%02X%02X" % (round(r * 255), round(g * 255), round(b * 255))


def tone_colors(i):
    """(fond, bordure, lettre) de la teinte i : même ton, trois luminosités."""
    hue = i * 360 / TONES
    return _hsl(hue, .62, .90), _hsl(hue, .52, .74), _hsl(hue, .66, .26)


def tone_css():
    rules = []
    for i in range(TONES):
        bg, border, fg = tone_colors(i)
        rules.append(f".tone-{i} avatar {{ background-color: {bg}; "
                     f"border-color: {border}; color: {fg}; }}")
    return "\n".join(rules)


def theme_css(dark):
    return ((TOKENS_DARK if dark else TOKENS_LIGHT)
            + CSS.replace("{SERIF}", SERIF) + tone_css())

